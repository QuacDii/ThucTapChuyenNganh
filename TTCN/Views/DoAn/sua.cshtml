@model TTCN.Models.DoAn

@{
    ViewData["Title"] = "Cập nhật Combo";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="card shadow mb-4" style="max-width: 1000px; margin: 0 auto;">

        <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom-primary">
            <h5 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-edit mr-2"></i> Cập nhật thông tin Combo
            </h5>
        </div>

        <div class="card-body">
            <form asp-action="sua" method="post" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="MaCombo" />
                <input type="hidden" asp-for="HinhAnh" />

                <div class="row">
                    <div class="col-md-8 border-right">

                        <div class="form-group mb-4">
                            <label asp-for="MoTa" class="control-label font-weight-bold">Tên Combo / Mô tả chi tiết</label>
                            <textarea asp-for="MoTa" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="MoTa" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="Gia" class="control-label font-weight-bold">Giá bán</label>
                                    <div class="input-group">
                                        <input asp-for="Gia" class="form-control" type="number" min="1000" step="1000" asp-format="{0:0}" />
                                        <div class="input-group-append">
                                            <span class="input-group-text font-weight-bold">VNĐ</span>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Gia" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="control-label font-weight-bold d-block">Trạng thái kinh doanh</label>
                                    <div class="form-check form-switch mt-2 pl-5">
                                        <input class="form-check-input" type="checkbox" asp-for="TrangThai" id="statusSwitch" style="transform: scale(1.3);">
                                        <label class="form-check-label ml-2" for="statusSwitch">
                                            @(Model.TrangThai ? "Đang bán" : "Tạm ngưng")
                                        </label>
                                    </div>
                                    <small class="text-muted mt-2 d-block">Gạt tắt nếu muốn tạm ngưng bán món này.</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 d-flex flex-column align-items-center justify-content-start pt-2">
                        <label class="control-label font-weight-bold align-self-start">Hình ảnh minh họa</label>

                        <div class="mb-3 position-relative" style="width: 100%; height: 250px; border: 2px dashed #d1d3e2; border-radius: 10px; display: flex; align-items: center; justify-content: center; overflow: hidden; background-color: #f8f9fc;">

                            @if (!string.IsNullOrEmpty(Model.HinhAnh))
                            {
                                string imgSrc = Model.HinhAnh.StartsWith("/") ? Model.HinhAnh : "/" + Model.HinhAnh;

                                <img id="previewPoster" src="@imgSrc" alt="Ảnh hiện tại"
                                     style="width: 100%; height: 100%; object-fit: cover;" />

                                <span id="placeholderText" class="text-gray-500 text-center px-3" style="display: none;">
                                    <i class="fas fa-image fa-2x mb-2"></i><br>Chưa chọn ảnh
                                </span>
                            }
                            else
                            {
                                <img id="previewPoster" src="#" alt="Xem trước ảnh"
                                     style="width: 100%; height: 100%; object-fit: cover; display: none;" />

                                <span id="placeholderText" class="text-gray-500 text-center px-3">
                                    <i class="fas fa-image fa-2x mb-2"></i><br>Chưa chọn ảnh
                                </span>
                            }
                        </div>

                        <div class="w-100">
                            <label class="small text-muted mb-1">Chọn ảnh mới để thay thế (nếu muốn):</label>
                            <input type="file" name="fDoan" class="form-control" id="inputPoster" accept="image/*">
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="text-center">
                    <a asp-action="Index" class="btn btn-secondary px-4 mr-2 shadow-sm">
                        <i class="fas fa-arrow-left mr-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm font-weight-bold">
                        <i class="fas fa-save mr-1"></i> Lưu thay đổi
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Script xem trước ảnh
        document.getElementById('inputPoster').addEventListener('change', function (e) {
            var file = e.target.files[0];
            var preview = document.getElementById('previewPoster');
            var placeholder = document.getElementById('placeholderText');

            if (file) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';    // Hiện ảnh mới
                    if(placeholder) placeholder.style.display = 'none'; // Ẩn chữ placeholder
                }
                reader.readAsDataURL(file);
            }
        });

        // Script đổi text trạng thái
        document.getElementById('statusSwitch').addEventListener('change', function() {
            var label = this.nextElementSibling;
            if(this.checked) {
                label.innerText = "Đang bán";
                label.classList.remove("text-danger");
            } else {
                label.innerText = "Tạm ngưng";
                label.classList.add("text-danger");
            }
        });
    </script>
}