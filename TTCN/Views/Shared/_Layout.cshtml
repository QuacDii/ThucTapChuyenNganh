@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@using TTCN.Models
@inject QLDVContext _context

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Cinema</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css">

    <style>
        /* --- CSS CHO SEARCH BOX --- */
        #suggestion-box {
            background-color: #1a1a1a;
            border-radius: 0 0 8px 8px;
            border: 1px solid #333;
            border-top: none;
        }

        .suggestion-item {
            display: flex;
            align-items: center;
            padding: 12px 15px;
            background: #1a1a1a;
            border-bottom: 1px solid #333;
            text-decoration: none;
            color: #fff;
            transition: all 0.2s ease;
            cursor: pointer;
        }

            .suggestion-item:hover {
                background-color: #333;
                color: #e50914;
                padding-left: 20px;
            }

            .suggestion-item img {
                width: 45px;
                height: 65px;
                object-fit: cover;
                margin-right: 15px;
                border-radius: 4px;
            }

        /* --- CSS CHO MỤC QUẢN TRỊ --- */
           
        .navbar .dropdown-menu .admin-vip-link:hover {
                background-color: #333 !important; 
            color: #ffc107 !important;
        }
        /* --- NÚT LOGIN TRÒN --- */
        .btn-login {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            cursor: pointer;
        }

            .btn-login:hover {
                background-color: #e50914;
                border-color: #e50914;
                color: white;
            }

        .footer-scroll-box {
            max-height: 200px; 
            overflow-y: auto; 
            padding-right: 5px; 
        }

            .footer-scroll-box::-webkit-scrollbar {
                width: 6px;
            }

            .footer-scroll-box::-webkit-scrollbar-track {
                background: #333; 
                border-radius: 3px;
            }

            .footer-scroll-box::-webkit-scrollbar-thumb {
                background: #555; 
                border-radius: 3px;
            }

                .footer-scroll-box::-webkit-scrollbar-thumb:hover {
                    background: #e50914; 
                }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

    <nav class="navbar navbar-expand-lg navbar-dark sticky-top" style="background-color: #141414; border-bottom: 1px solid #333;">
        <div class="container-fluid px-4">

            <a class="navbar-brand me-4 fw-bold d-flex align-items-center" asp-controller="Home" asp-action="Index"
               style="font-family: 'Inter', sans-serif; font-size: 1.8rem; color: #e50914; letter-spacing: 1px;">
                CINEMA
            </a>

            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse align-items-center" id="navbarContent">

                <ul class="navbar-nav me-auto mb-2 mb-lg-0 d-flex align-items-center">
                    <li class="nav-item">
                        <a class="nav-link text-uppercase px-3 fw-medium text-nowrap" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase px-3 fw-medium text-nowrap" asp-controller="Phim" asp-action="TimKiem">Phim</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase px-3 fw-medium" asp-controller="LichChieu" asp-action="TheoRap">Lịch Chiếu Theo Rạp</a>

                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase px-3 fw-medium text-nowrap" asp-controller="CumRap" asp-action="DsRap">Cụm Rạp</a>
                    </li>
                </ul>

                <form asp-controller="Phim" asp-action="TimKiem" class="d-none d-xl-flex mx-auto position-relative" role="search" method="get" style="width: 400px; max-width: 100%;">
                    <div class="input-group w-100">
                        <input class="form-control border-0 bg-dark text-white" type="search" name="tuKhoa" id="keyword"
                               placeholder="Tìm tên phim..." autocomplete="off"
                               style="border-radius: 20px 0 0 20px; padding-left: 20px;">
                        <button class="btn btn-danger border-0" type="submit" id="btnSearch" style="border-radius: 0 20px 20px 0; padding-left: 15px; padding-right: 15px;">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                    <div id="suggestion-box" class="list-group position-absolute shadow w-100"
                         style="top: 100%; left: 0; z-index: 1050; display: none; margin-top: 5px;">
                    </div>
                </form>

                <div class="d-flex align-items-center justify-content-end ms-auto gap-3">

                    @{
                        var userEmail = HttpContextAccessor.HttpContext.Session.GetString("UserEmail");
                        var userRole = HttpContextAccessor.HttpContext.Session.GetString("UserVaiTro");
                    }

                    @if (!string.IsNullOrEmpty(userEmail))
                    {
                        <div class="dropdown">
                            <a class="text-white text-decoration-none dropdown-toggle d-flex align-items-center py-1 px-2 rounded hover-bg-dark"
                               href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"
                               style="transition: 0.2s; white-space: nowrap;">

                                <div class="bg-gradient rounded-circle d-flex align-items-center justify-content-center me-2 text-white fw-bold flex-shrink-0"
                                     style="width: 40px; height: 40px; background-color: #e50914; font-size: 1.2rem;">
                                    @(HttpContextAccessor.HttpContext.Session.GetString("UserHoTen")?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                                <div class="d-none d-lg-block text-start">
                                    <div class="small text-white-50" style="font-size: 0.75rem; line-height: 1;">Xin chào,</div>
                                    <div class="fw-bold text-white text-truncate" style="font-size: 0.95rem; max-width: 150px;">
                                        @HttpContextAccessor.HttpContext.Session.GetString("UserHoTen")
                                    </div>
                                </div>
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end shadow-lg mt-2 bg-dark border-secondary">
                                <li><span class="dropdown-item-text text-white-50 small">Tài khoản</span></li>

                                @if (userRole == "Admin")
                                {
                                    <li>
                                        <a class="dropdown-item admin-vip-link" asp-controller="Users" asp-action="Index">
                                            <i class="fas fa-user-shield me-2"></i>Quản trị hệ thống
                                        </a>
                                    </li>
                                }
                                else
                                {
                                    <li>
                                        <a class="dropdown-item text-white" asp-controller="DonDatVe" asp-action="LichSu">
                                            <i class="fas fa-ticket-alt me-2"></i>Vé của tôi
                                        </a>
                                    </li>
                                }

                                <li><hr class="dropdown-divider bg-secondary"></li>
                                <li>
                                    <a class="dropdown-item text-danger fw-bold" asp-controller="Account" asp-action="Logout">
                                        <i class="fas fa-sign-out-alt me-2"></i>Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-light btn-sm rounded-pill px-4 fw-bold text-nowrap" data-bs-toggle="modal" data-bs-target="#loginModal">
                            <i class="fas fa-user-circle me-1"></i> Đăng nhập
                        </button>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="main-content">
        @RenderBody()
    </div>

    <footer class="pt-5 pb-4 mt-auto">
        <div class="container text-center text-md-start">
            <div class="row text-center text-md-start">
                <div class="col-md-3 col-lg-3 col-xl-3 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 font-weight-bold" style="color: var(--brand-red);">CINEMA</h5>
                    <p>Trải nghiệm điện ảnh tuyệt vời nhất tại hệ thống rạp của chúng tôi. Đặt vé nhanh chóng, an toàn.</p>
                </div>
                <div class="col-md-2 col-lg-2 col-xl-2 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 font-weight-bold text-white">Phim</h5>
                    <p><a href="/#phim-dang-chieu" class="footer-link">Phim đang chiếu</a></p>
                    <p><a href="/#phim-sap-chieu" class="footer-link">Phim sắp chiếu</a></p>
                </div>
                <div class="col-md-3 col-lg-2 col-xl-2 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 font-weight-bold text-white">Hệ thống rạp</h5>

                    <div class="footer-scroll-box">
                        @{
                            var allRaps = _context.CumRaps.OrderBy(x => x.TenCumRap).ToList();
                        }

                        @if (allRaps != null && allRaps.Any())
                        {
                            foreach (var rap in allRaps)
                            {
                                <p class="mb-2">
                                    <a asp-controller="CumRap"
                                       asp-action="DsRap"
                                       asp-route-maCumRap="@rap.MaCumRap"
                                       class="footer-link"
                                       style="font-size: 0.9rem;">
                                        @rap.TenCumRap
                                    </a>
                                </p>
                            }
                        }
                    </div>
                </div>
                <div class="col-md-4 col-lg-3 col-xl-3 mx-auto mt-3">
                    <h5 class="text-uppercase mb-4 font-weight-bold text-white">Liên hệ</h5>
                    <p><i class="fas fa-home me-3"></i> 180, Cao Lỗ, Q.8, Tp.Hồ Chí Minh</p>
                    <p><i class="fas fa-envelope me-3"></i> support@cinema.vn</p>
                    <p><i class="fas fa-phone me-3"></i> 1900 1234</p>
                </div>
            </div>
            <hr class="mb-4" style="border-color: #333;">
            <div class="row align-items-center">
                <div class="col-md-7 col-lg-8">
                    <p>© 2025 Bản quyền thuộc về: <a href="#" class="footer-link fw-bold">Cinema.vn</a></p>
                </div>
                <div class="col-md-5 col-lg-4">
                    <div class="text-center text-md-end">
                        <a href="https://www.facebook.com/" class="footer-link social-icon"><i class="fab fa-facebook-f"></i></a>
                        <a href="https://www.instagram.com/" class="footer-link social-icon"><i class="fab fa-instagram"></i></a>
                        <a href="https://www.youtube.com/" class="footer-link social-icon"><i class="fab fa-youtube"></i></a>
                        <a href="https://www.tiktok.com/vi-VN/" class="footer-link social-icon"><i class="fab fa-tiktok"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-3">
                <div class="modal-header modal-header-custom">
                    <h4 class="modal-title text-white" id="loginModalLabel">Đăng Nhập</h4>
                    <button type="button" class="btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="background:none; border:none; color:white; font-size:1.5rem;">&times;</button>
                </div>
                <form id="loginForm" asp-controller="Account" asp-action="Login" method="post">
                    <div class="modal-body p-4">
                        <div id="loginErrorAlert" class="alert alert-danger" role="alert" style="display: none;"></div>

                        <div class="form-floating mb-3">
                            <input type="email" class="form-control" id="email" name="email" placeholder="name@example.com" required>
                            <label for="email">Email</label>
                        </div>

                        <div class="form-floating mb-3 position-relative">
                            <input type="password" class="form-control" id="matKhau" name="matKhau" placeholder="Mật khẩu" required>
                            <label for="matKhau">Mật khẩu</label>
                            <button type="button" class="password-toggle-icon" id="togglePasswordIcon">
                                <i class="fas fa-eye" id="iconEyeOpen"></i>
                                <i class="fas fa-eye-slash" id="iconEyeClosed" style="display:none;"></i>
                            </button>
                        </div>

                        <input type="hidden" name="returnUrl" id="loginReturnUrl" value="" />
                        <button type="submit" class="btn-login-submit w-100">Đăng nhập</button>
                        <div class="login-links mt-3 text-center">
                            <a asp-controller="Account" asp-action="QuenMatKhau">Đổi/Quên mật khẩu?</a> | <a asp-controller="Account" asp-action="DangKy">Đăng ký</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100">
        @if (TempData["Success"] != null)
        {
            <div id="successToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body"><i class="fas fa-check-circle me-2"></i> @TempData["Success"]</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            // LOGIC TÌM KIẾM
            const input = document.getElementById('keyword');
            const suggestionBox = document.getElementById('suggestion-box');
            const btnSearch = document.getElementById('btnSearch');

            if (btnSearch) {
                btnSearch.addEventListener('click', function(e) {
                    if (input.value.trim() === "") {
                        e.preventDefault();
                        suggestionBox.innerHTML = '<div class="p-3 text-white text-center">Không tìm thấy kết quả</div>';
                        suggestionBox.style.display = 'block';
                    }
                });
            }

            let timeout = null;
            if(input) {
                input.addEventListener('input', function() {
                    const term = this.value.trim();
                    clearTimeout(timeout);
                    if (term.length < 2) {
                        suggestionBox.style.display = 'none';
                        return;
                    }
                    timeout = setTimeout(() => {
                        fetch(`/Phim/GetSearchSuggestions?term=${encodeURIComponent(term)}`)
                            .then(response => response.json())
                            .then(data => {
                                suggestionBox.innerHTML = '';
                                if (data.length > 0) {
                                    data.forEach(item => {
                                        const link = document.createElement('a');
                                        link.href = `/Phim/chiTiet/${item.id}`;
                                        link.className = 'suggestion-item';
                                        link.innerHTML = `<img src="/${item.image}" alt="${item.label}"><div><span class="font-weight-bold">${item.label}</span></div>`;
                                        suggestionBox.appendChild(link);
                                    });
                                } else {
                                    suggestionBox.innerHTML = '<div class="p-3 text-white text-center">Không tìm thấy phim phù hợp</div>';
                                }
                                suggestionBox.style.display = 'block';
                            })
                            .catch(err => console.error(err));
                    }, 300);
                });

                document.addEventListener('click', function(e) {
                    if (!input.contains(e.target) && !suggestionBox.contains(e.target)) {
                        suggestionBox.style.display = 'none';
                    }
                });
            }

            // LOGIC PASSWORD TOGGLE
            const toggleIcon = document.getElementById('togglePasswordIcon');
            const passInput = document.getElementById('matKhau');
            const eyeOpen = document.getElementById('iconEyeOpen');
            const eyeClosed = document.getElementById('iconEyeClosed');
            if(toggleIcon) {
                toggleIcon.addEventListener('click', function() {
                    const isPass = passInput.type === 'password';
                    passInput.type = isPass ? 'text' : 'password';
                    eyeOpen.style.display = isPass ? 'none' : 'block';
                    eyeClosed.style.display = isPass ? 'block' : 'none';
                });
            }

            // TOAST & MODAL LOGIC
            var successToastEl = document.getElementById('successToast');
            if (successToastEl) new bootstrap.Toast(successToastEl).show();

            var loginModal = document.getElementById('loginModal');
            if (loginModal) {
                loginModal.addEventListener('show.bs.modal', function (event) {
                    var returnInput = document.getElementById('loginReturnUrl');
                    if (returnInput) returnInput.value = window.location.pathname + window.location.search;
                });
            }

            // LOGIN SUBMIT
            var loginForm = document.getElementById('loginForm');
            if (loginForm) {
                loginForm.addEventListener('submit', async function (e) {
                    e.preventDefault();
                    var errorAlert = document.getElementById('loginErrorAlert');
                    var loginButton = loginForm.querySelector('.btn-login-submit');
                    loginButton.disabled = true; loginButton.innerText = "ĐANG XỬ LÝ...";
                    errorAlert.style.display = 'none';
                    try {
                        var formData = new FormData(loginForm);
                        var response = await fetch(loginForm.action, { method: 'POST', body: new URLSearchParams(formData) });
                        var result = await response.json();
                        if (result.success) {
                            window.location.href = window.desiredRedirectUrl || result.redirectUrl || window.location.href;
                        } else {
                            errorAlert.innerText = result.message;
                            errorAlert.style.display = 'block';
                        }
                    } catch (error) {
                        errorAlert.innerText = 'Lỗi kết nối server.';
                        errorAlert.style.display = 'block';
                    } finally {
                        loginButton.disabled = false;
                        loginButton.innerText = "Đăng nhập";
                    }
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>