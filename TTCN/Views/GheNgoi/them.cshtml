@model TTCN.Models.GheNgoi

@{
    ViewData["Title"] = "Thêm Ghế Ngồi";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="card shadow mb-4" style="max-width: 800px; margin: 0 auto;">

        <div class="card-header py-3 bg-white border-bottom-primary">
            <h5 class="m-0 font-weight-bold text-primary">
                Thêm Ghế Mới (Lẻ)
            </h5>
        </div>

        <div class="card-body">
            <form asp-action="them" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label class="control-label font-weight-bold">Chọn Cụm Rạp</label>
                            <select id="ddlCumRap" class="form-control form-select" asp-items="ViewBag.DsCumRap">
                                <option value="">-- Vui lòng chọn Rạp trước --</option>
                            </select>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="MaPhong" class="control-label font-weight-bold">Thuộc Phòng Chiếu</label>
                            <select asp-for="MaPhong" id="ddlPhong" class="form-control form-select">
                                <option value="">-- Chọn Phòng --</option>
                            </select>
                            <span asp-validation-for="MaPhong" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="TenGhe" class="control-label font-weight-bold">Tên Ghế</label>
                            <input asp-for="TenGhe" class="form-control" placeholder="Ví dụ: A1, B5..." />
                            <span asp-validation-for="TenGhe" class="text-danger"></span>
                            <small class="text-muted fst-italic">Nhập đúng định dạng: Hàng + Số</small>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="HangGhe" class="control-label font-weight-bold">Hàng Ghế</label>
                            <select asp-for="HangGhe" class="form-control form-select" asp-items="ViewBag.HangGheList">
                                <option value="">-- Chọn Hàng --</option>
                            </select>
                            <span asp-validation-for="HangGhe" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="LoaiGhe" class="control-label font-weight-bold">Loại Ghế</label>
                            <select asp-for="LoaiGhe" class="form-control form-select" asp-items="ViewBag.LoaiGheList">
                                <option value="">-- Chọn Loại --</option>
                            </select>
                            <span asp-validation-for="LoaiGhe" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="text-center">
                    <a asp-action="Index" class="btn btn-secondary px-4 mr-2">
                        <i class="fas fa-arrow-left mr-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save mr-1"></i> Lưu lại
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Khi người dùng chọn Rạp
            $('#ddlCumRap').change(function () {
                var cumRapId = $(this).val();
                var ddlPhong = $('#ddlPhong');

                // Xóa danh sách phòng cũ
                ddlPhong.empty();
                ddlPhong.append('<option value="">-- Đang tải danh sách phòng... --</option>');

                if (cumRapId) {
                    // Gọi API lấy danh sách phòng
                    $.ajax({
                        url: '/GheNgoi/GetPhongByCumRap',
                        type: 'GET',
                        data: { cumRapId: cumRapId },
                        success: function (data) {
                            ddlPhong.empty(); // Xóa chữ "Đang tải..."
                            ddlPhong.append('<option value="">-- Chọn Phòng --</option>');

                            if (data.length === 0) {
                                ddlPhong.append('<option value="" disabled>Rạp này chưa có phòng nào</option>');
                            } else {
                                $.each(data, function (index, item) {
                                    ddlPhong.append('<option value="' + item.id + '">' + item.name + '</option>');
                                });
                            }
                        },
                        error: function() {
                            alert("Lỗi tải danh sách phòng!");
                        }
                    });
                } else {
                    ddlPhong.empty();
                    ddlPhong.append('<option value="">-- Vui lòng chọn Rạp trước --</option>');
                }
            });
        });
    </script>
}