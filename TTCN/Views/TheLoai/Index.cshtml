@model IEnumerable<TTCN.Models.TheLoai>

@{
    ViewData["Title"] = "Quản lý Thể Loại";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .table thead th {
        background-color: #4e73df;
        color: white;
        border: none;
        white-space: nowrap;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
        color: #5a5c69;
    }

    .btn-circle {
        width: 30px;
        height: 30px;
        padding: 6px 0px;
        border-radius: 15px;
        text-align: center;
        font-size: 12px;
        line-height: 1.42857;
    }
</style>

<div class="container-fluid">
    <div class="card shadow mb-4 border-0">
        <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom-primary">
            <h5 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-tags mr-2"></i> Danh sách Thể Loại
            </h5>
            <a asp-action="them" class="btn btn-primary btn-icon-split shadow-sm">
                <span class="icon text-white-50">
                    <i class="fas fa-plus"></i>
                </span>
                <span class="text">Thêm Thể Loại</span>
            </a>
        </div>

        <div class="card-body" style="margin: 0 auto;">

            <form asp-action="Index" method="get" class="mb-4">
                <div class="row g-3 align-items-center">

                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-right-0">
                                <i class="fas fa-search text-gray-400"></i>
                            </span>
                            <input type="text" name="search" value="@ViewBag.CurrentFilter"
                                   class="form-control border-left-0"
                                   placeholder="Tìm thể loại...">
                        </div>
                    </div>

                    <div class="col-md-7 d-flex align-items-center">

                        <button type="submit" class="btn btn-primary shadow-sm px-4">
                            <i class="fas fa-filter fa-sm text-white-50 me-2"></i>Lọc
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm ms-1" title="Tải lại">
                            <i class="fas fa-sync-alt"></i>
                        </a>

                        <div class="border-start mx-3" style="height: 24px; border-color: #e3e6f0 !important;"></div>
                        <div class="d-flex align-items-center text-nowrap">
                            <span class="text-muted small">Tổng:</span>
                            <span class="badge bg-light text-dark border ms-2 me-1 px-2 py-1">
                                @(Model != null ? Model.Count() : 0)
                                </span>
                            <span class="text-muted small">thể loại</span>
                        </div>
                    </div>
                </div>
            </form>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-lg mb-4 border-0 rounded-lg overflow-hidden" style="max-width: 600px; margin: 0 auto;">


                <div class="table-responsive">
                    <table class="table table-hover mb-0" id="dataTable" cellspacing="0">
                        <thead>
                            <tr class="text-center">
                                <th class="text-center" style="width: 100px;">
                                    @Html.DisplayNameFor(model => model.FirstOrDefault().MaTheLoai)
                                </th>

                                <th class="text-start">
                                    @Html.DisplayNameFor(model => model.FirstOrDefault().TenTheLoai)
                                </th>

                                <th class="text-center" style="width: 120px;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="text-center font-weight-bold">@item.MaTheLoai</td>

                                        <td class="text-start font-weight-bold text-primary">
                                            @item.TenTheLoai
                                        </td>

                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <a asp-action="sua" asp-route-id="@item.MaTheLoai" class="btn btn-outline-warning btn-sm shadow-sm" title="Sửa">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="xoa" asp-route-id="@item.MaTheLoai" class="btn btn-outline-danger btn-sm shadow-sm ml-1" title="Xóa">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-5">
                                        <img src="https://via.placeholder.com/100x100?text=Empty" class="mb-3 opacity-50" style="width: 60px" />
                                        <p class="text-muted mb-0">Chưa có dữ liệu thể loại nào.</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                </div>

            </div>
        </div>
    </div>
</div>