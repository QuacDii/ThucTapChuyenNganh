@model IEnumerable<TTCN.Models.User>
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Người dùng";
    var roleList = ViewBag.RoleList as List<string>;

    // Lấy Email hiện tại từ Session
    var currentEmail = HttpContextAccessor.HttpContext?.Session.GetString("UserEmail");
}

<style>
    .table thead th {
        background-color: #4e73df;
        color: white;
        border: none;
        white-space: nowrap;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
        color: #5a5c69;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fc;
    }

    .user-name {
        font-weight: 600;
        color: #4e73df;
    }

    .user-email {
        font-style: italic;
        color: #858796;
    }
</style>

<div class="container-fluid">
    <div class="card shadow mb-4 border-0">

        <div class="card-header py-3 bg-white border-bottom-primary">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="m-0 font-weight-bold text-primary">
                    <i class="fas fa-users mr-2"></i> Danh sách Tài khoản
                </h5>

                <a asp-action="them" class="btn btn-primary shadow-sm">
                    <i class="fas fa-user-plus fa-sm text-white-50 mr-1"></i> Thêm Tài khoản
                </a>
            </div>
        </div>

        <div class="card-body">
            <form asp-action="Index" method="get" class="mb-4">
                <div class="d-flex align-items-center">

                    <div class="input-group me-2" style="width: 350px;">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fas fa-search text-gray-400"></i>
                        </span>
                        <input type="text" name="search" value="@ViewBag.CurrentFilter"
                               class="form-control border-start-0"
                               placeholder="Tìm theo tên, Email, SĐT..." aria-label="Search">
                    </div>

                    <div class="me-3" style="width: 200px;">
                        <select name="vaiTro" class="form-control form-select bg-light">
                            <option value="">-- Tất cả vai trò --</option>
                            @if (roleList != null)
                            {
                                foreach (var role in roleList)
                                {
                                    if ((string)ViewBag.CurrentRole == role)
                                    {
                                        <option value="@role" selected>@role</option>
                                    }
                                    else
                                    {
                                        <option value="@role">@role</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary shadow-sm px-3">
                        <i class="fas fa-filter text-white-50"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary border shadow-sm ms-2" title="Tải lại">
                        <i class="fas fa-sync-alt "></i>
                    </a>

                    <div class="border-end mx-3" style="height: 24px;"></div>

                    <div class="d-flex align-items-center text-nowrap">
                        <span class="text-muted small">Tổng:</span>
                        <span class="badge bg-light text-dark border ms-2 me-1 px-2 py-1">
                            @(Model != null ? Model.Count() : 0)
                        </span>
                        <span class="text-muted small">tài khoản</span>
                    </div>

                </div>
            </form>

        </div>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Bảng dữ liệu -->
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                    <tr class="text-center">
                        <th>
                            @Html.DisplayNameFor(model => model.FirstOrDefault().MaUsers)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.FirstOrDefault().HoTen)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.FirstOrDefault().Email)
                        </th>

                        <th style="width: 80px;">
                            @Html.DisplayNameFor(model => model.FirstOrDefault().MatKhau)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.FirstOrDefault().SoDienThoai)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.FirstOrDefault().VaiTro)
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.FirstOrDefault().NgayTao)
                        </th>
                        <th style="width: 100px;">Thao tác</th>
                    </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model.OrderByDescending(x=>x.NgayTao))
                            {
                                <tr>
                                <td class="text-center font-weight-bold">@item.MaUsers</td>

                                    <td class="user-name text-center">@item.HoTen</td>

                                    <td><span class="user-email">@item.Email</span></td>

                                    <td class="text-center">@item.MatKhau</td>

                                    <td class="text-center">@item.SoDienThoai</td>

                                    <td class="text-center">
                                        @if (item.VaiTro == "Admin")
                                        {
                                            <span class="badge bg-danger py-2 shadow-sm" style="width: 110px;">
                                                <i class="fas fa-user-shield fa-fw mr-1"></i> @item.VaiTro
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success py-2 shadow-sm" style="width: 110px;">
                                                <i class="fas fa-user fa-fw mr-1"></i> @item.VaiTro
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @item.NgayTao.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-center">
                                        @{
                                            bool isCurrentUser = false;
                                            if (!string.IsNullOrEmpty(currentEmail) && !string.IsNullOrEmpty(item.Email))
                                            {
                                                isCurrentUser = item.Email.Trim().Equals(currentEmail.Trim(), StringComparison.OrdinalIgnoreCase);
                                            }
                                        }

                                        @if (isCurrentUser)
                                        {
                                            <button class="btn btn-secondary btn-sm shadow-sm" disabled title="Bạn đang đăng nhập tài khoản này">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <a asp-action="xoa" asp-route-id="@item.MaUsers" class="btn btn-outline-danger btn-sm shadow-sm">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5">
                                    <p class="text-muted mb-0">Không tìm thấy tài khoản nào.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>