@using TTCN.Models
@model IEnumerable<TTCN.Models.CumRap>

@{
    ViewData["Title"] = "Hệ thống Rạp & Phim Hot";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var allRaps = ViewBag.AllRaps as List<CumRap>;
    var phimHots = ViewBag.PhimHot as List<TTCN.Models.Phim>;
    var dictDiem = ViewBag.DiemDanhGia as Dictionary<int, int>;
    var currentLabel = ViewBag.CurrentLabel as string;
}

<style>
    /* --- 1. CSS CHO DROPDOWN --- */
    .dropdown-submenu {
        position: relative;
    }

        .dropdown-submenu > .dropdown-menu {
            top: 0;
            left: 100%;
            margin-top: -1px;
            display: none;
            background-color: #222;
            border: 1px solid #444;
        }

        .dropdown-submenu:hover > .dropdown-menu {
            display: block;
        }

    .dropdown-item-tp {
        color: #ddd;
        padding: 10px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        text-decoration: none;
        white-space: nowrap;
    }

        .dropdown-item-tp:hover {
            background-color: #e50914;
            color: white;
            text-decoration: none;
        }

    .dropdown-menu {
        background-color: #1a1a1a;
        border: 1px solid #333;
    }

    /* --- 2. CSS MOVIE CARD --- */
    .movie-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        background: transparent !important;
        border: none;
        overflow: hidden;
        margin-bottom: 20px;
    }

        .movie-card:hover {
            transform: translateY(-5px);
        }

    .card-img-wrapper {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.3);
    }

        .card-img-wrapper img {
            transition: transform 0.5s ease;
            aspect-ratio: 2/3;
            width: 100%;
            object-fit: cover;
        }

    .movie-card:hover .card-img-wrapper img {
        transform: scale(1.1);
        opacity: 0.7;
    }

    .play-icon {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0);
        font-size: 3.5rem;
        color: white;
        transition: all 0.3s;
        opacity: 0;
        z-index: 10;
        pointer-events: none;
    }

    .movie-card:hover .play-icon {
        transform: translate(-50%, -50%) scale(1);
        opacity: 1;
    }

    .rating-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background: rgba(229, 9, 20, 0.9);
        color: white;
        padding: 5px 10px;
        border-radius: 6px;
        font-weight: bold;
        box-shadow: 0 2px 5px rgba(0,0,0,0.5);
        z-index: 5;
    }

    .movie-title {
        color: #fff;
        font-weight: 700;
        font-size: 1rem;
        text-decoration: none;
        text-align: center; 
        white-space: normal; 
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        height: 45px; 
        line-height: 1.4; 
        margin: 10px auto 0 auto; 
        padding: 0 5px; 

        transition: color 0.2s;
    }

        .movie-title:hover {
            color: #e50914;
        }

    .movie-meta {
        color: #aaa;
        font-size: 0.85rem;
        margin-bottom: 10px;
    }

    .btn-custom-red {
        background-color: #e50914;
        color: white;
        border-radius: 6px;
        font-weight: 600;
        text-transform: uppercase;
        transition: all 0.3s;
        border: none;
        font-size: 0.9rem;
        padding: 10px;
        width: 100%;
        display: block;
        text-align: center;
    }

        .btn-custom-red:hover {
            background-color: #b20710;
            box-shadow: 0 0 15px rgba(229, 9, 20, 0.6);
            color: white;
            transform: translateY(-2px);
            text-decoration: none;
        }
</style>

<div class="container py-5" style="margin-top: 60px;">

    <div class="d-flex justify-content-between align-items-center mb-5 border-bottom border-secondary pb-3">
        <div class="dropdown">
            <button class="btn btn-outline-light dropdown-toggle px-4 py-2" type="button" id="dropdownMenuButton" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-map-marker-alt me-2 text-red"></i> @currentLabel
            </button>
            <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton">
                @if (allRaps != null)
                {
                    foreach (var group in allRaps.GroupBy(x => x.ThanhPho))
                    {
                        <li class="dropdown-submenu">
                            <a class="dropdown-item-tp" href="#">@group.Key <i class="fas fa-chevron-right ms-2" style="font-size: 0.8em;"></i></a>
                            <ul class="dropdown-menu">
                                @foreach (var rap in group)
                                {
                                    <li><a class="dropdown-item-tp" href="@Url.Action("DsRap", new { maCumRap = rap.MaCumRap })">@rap.TenCumRap</a></li>
                                }
                            </ul>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>

    <div class="row">
      <div class="col-lg-6 mb-4">
    @{
        var rapHienTai = Model?.FirstOrDefault();
    }

    @if (rapHienTai != null)
    {
        var fullAddress = rapHienTai.DiaChi + ", " + rapHienTai.ThanhPho;
        var mapUrl = $"https://maps.google.com/maps?q={System.Net.WebUtility.UrlEncode(fullAddress)}&t=&z=15&ie=UTF8&iwloc=&output=embed";

        <div style="background-color: #1a1a1a; padding: 20px; border-radius: 8px; color: #e0e0e0; box-shadow: 0 4px 6px rgba(0,0,0,0.3);">
            
            <h5 style="color: #fff; margin-bottom: 15px; font-weight: 600;">
                Thông tin liên hệ @rapHienTai.TenCumRap:
            </h5>

            <div style="font-size: 0.95rem; line-height: 1.6; font-style: italic; color: #ccc;">
                <p class="mb-1">
                    <strong>Địa chỉ:</strong> @rapHienTai.DiaChi
                </p>
                <p class="mb-3">
                    <strong>Hotline:</strong> 1900 1234  </p>
            </div>

            <p style="font-size: 0.9rem; line-height: 1.5; margin-bottom: 20px; color: #aaa;">
                Mua phiếu quà tặng, mua vé số lượng lớn, đặt phòng chiếu tổ chức hội nghị, 
                trưng bày quảng cáo liên hệ hotline - 0399 475 165 để được hưởng ưu đãi tốt nhất bạn nhé!
            </p>

            <div class="map-container" style="width: 100%; height: 350px; overflow: hidden; border-radius: 6px; border: 1px solid #444;">
                <iframe 
                    width="100%" 
                    height="100%" 
                    frameborder="0" 
                    scrolling="no" 
                    marginheight="0" 
                    marginwidth="0" 
                    src="@mapUrl">
                </iframe>
            </div>
            
            <div class="mt-4">
                <a href="@Url.Action("LichChieu", "SuatChieu", new { maCumRap = rapHienTai.MaCumRap })" class="btn btn-custom-red w-100">
                    <i class="fas fa-ticket-alt me-2"></i> ĐẶT VÉ NGAY
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-dark text-white-50">Vui lòng chọn rạp để xem thông tin.</div>
    }
</div>

        <div class="col-lg-6">
            <h4 class="mb-4 text-white border-4 ps-2 text-center">PHIM ĐANG HOT</h4>

            <div class="row row-cols-1 row-cols-md-2 g-4">
                @if (phimHots != null && phimHots.Any())
                {
                    foreach (var item in phimHots)
                    {
                        double diem = 0;
                        if (dictDiem != null && dictDiem.TryGetValue(item.MaPhim, out int val))
                        {
                            diem = val;
                        }

                        <div class="col">
                            <div class="card movie-card h-100">
                                <div class="card-img-wrapper">
                                    <img src="/@item.PosterPhim" class="card-img-top" alt="@item.TenPhim" loading="lazy" style="cursor: pointer;"
                                         onclick="openTrailer('@item.TrailerPhim')">

                                    @if (diem > 0)
                                    {
                                        <span class="rating-badge">
                                            <i class="fas fa-star me-1 text-warning"></i>@diem
                                        </span>
                                    }

                                    <i class="fas fa-play-circle play-icon"></i>
                                </div>

                                <div class="card-body px-0 pt-3">
                                    <h5 class="card-title text-center mb-2">
                                        <a href="@Url.Action("chiTiet", "Phim", new { id = item.MaPhim })"
                                           class="movie-title">
                                            @item.TenPhim
                                        </a>
                                    </h5>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-white-50">Chưa có phim hot nào.</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="trailerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background-color: #000; border: 1px solid #333;">
            <div class="modal-header border-0 p-2">
                <h5 class="modal-title text-white">Trailer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 d-flex align-items-center justify-content-center" style="min-height: 400px; background: black;">
                <div id="trailerModalBody" class="w-100"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openTrailer(trailerUrl) {
            if (!trailerUrl || trailerUrl.trim() === "") {
                alert("Phim này chưa cập nhật trailer!");
                return;
            }
            if (!trailerUrl.startsWith("http") && !trailerUrl.startsWith("/")) {
                trailerUrl = "/" + trailerUrl;
            }

            var modalBody = document.getElementById('trailerModalBody');
            var videoHtml = `
                <video width="100%" controls autoplay style="max-height: 80vh; outline: none;">
                    <source src="${trailerUrl}" type="video/mp4">
                    Trình duyệt không hỗ trợ video.
                </video>
            `;

            modalBody.innerHTML = videoHtml;

            var myModal = new bootstrap.Modal(document.getElementById('trailerModal'));
            myModal.show();
        }

        var trailerModalEl = document.getElementById('trailerModal');
        if (trailerModalEl) {
            trailerModalEl.addEventListener('hidden.bs.modal', function () {
                document.getElementById('trailerModalBody').innerHTML = '';
            });
        }
    </script>
}