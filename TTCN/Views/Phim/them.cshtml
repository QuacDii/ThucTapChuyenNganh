@using TTCN.Models
@model TTCN.Models.Phim

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Thêm Phim Mới";

    var allTheLoais = ViewBag.AllTheLoais as List<TheLoai>;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Thông tin Phim Mới</h6>
            <a asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-left"></i> Quay lại Danh sách
            </a>
        </div>
        <div class="card-body">

            <form asp-action="them" method="post" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label asp-for="TenPhim" class="form-label"></label>
                            <input asp-for="TenPhim" class="form-control" placeholder="Tên của bộ phim...">
                            <span asp-validation-for="TenPhim" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MoTa" class="form-label"></label>
                            <textarea asp-for="MoTa" class="form-control" rows="8" placeholder="Nội dung tóm tắt phim..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PosterPhim" class="form-label"></label>

                            <input type="file" name="fPoster" class="form-control" id="inputPoster" accept="image/*">

                            <div class="mt-3">
                                <img id="previewPoster" src="#" alt="Poster Preview"
                                     style="width: 150px; height: 225px; object-fit: cover; border: 1px solid #ccc; display: none;" />
                            </div>

                            <input type="hidden" asp-for="PosterPhim" />
                            <span asp-validation-for="PosterPhim" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TrailerPhim" class="form-label"></label>
                            <input type="file" name="fTrailer" class="form-control" accept="video/*" />

                            @if (Model != null && !string.IsNullOrEmpty(Model.TrailerPhim))
                            {
                                <div class="mt-2">
                                    <small class="text-muted">Trailer hiện tại:</small><br />
                                    @if (Model.TrailerPhim.Contains("trailers/"))
                                    {
                                        <video width="320" height="180" controls class="mt-1 border rounded">
                                            <source src="~/@Model.TrailerPhim" type="video/mp4">
                                        </video>
                                    }
                                    else
                                    {
                                        <input type="text" class="form-control form-control-sm mt-1" value="@Model.TrailerPhim" readonly />
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="mb-3">
                            <label asp-for="DaoDien" class="form-label"></label>
                            <input asp-for="DaoDien" class="form-control">
                            <span asp-validation-for="DaoDien" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DienVien" class="form-label">Diễn viên</label>
                            <input asp-for="DienVien" class="form-control" id="inputDienVien" placeholder="Nhập tên các diễn viên...">
                            <span asp-validation-for="DienVien" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ThoiLuong" class="control-label font-weight-bold"></label>
                            <div class="input-group">
                                <input asp-for="ThoiLuong" class="form-control" />
                                <span class="input-group-text">phút</span>
                            </div>
                            <span asp-validation-for="ThoiLuong" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NgayPhatHanh" class="form-label"></label>
                            <input asp-for="NgayPhatHanh" type="text" class="form-control bg-white" id="ngayPhatHanh" placeholder="Chọn ngày...">
                            <span asp-validation-for="NgayPhatHanh" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NgayKetThuc" class="form-label"></label>
                            <input asp-for="NgayKetThuc" type="text" class="form-control bg-white" id="ngayKetThuc" placeholder="Chọn ngày...">
                            <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Thể Loại (Chọn nhiều)</label>

                            <div class="border rounded p-3 bg-light" style="max-height: 250px; overflow-y: auto;">
                                @if (allTheLoais != null && allTheLoais.Any())
                                {
                                    @foreach (var theLoai in allTheLoais)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input"
                                                   type="checkbox"
                                                   name="select"
                                                   value="@theLoai.MaTheLoai"
                                                   id="genre_@theLoai.MaTheLoai">

                                            <label class="form-check-label" for="genre_@theLoai.MaTheLoai">
                                                @theLoai.TenTheLoai
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted fst-italic">Chưa có thể loại nào.</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <hr />

                <div class="text-end">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-2"></i> Lưu Phim
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const config = {
                locale: "vn",
                dateFormat: "Y-m-d",   
                altInput: true,         
                altFormat: "d/m/Y",     
                allowInput: true        
            };

            // Khởi tạo lịch cho Ngày Phát Hành
            const startPicker = flatpickr("#ngayPhatHanh", {
                ...config,
                onChange: function (selectedDates, dateStr, instance) {
                    endPicker.set('minDate', dateStr);
                }
            });

            const endPicker = flatpickr("#ngayKetThuc", {
                ...config
            });
        });

        document.getElementById('inputPoster').addEventListener('change', function (e) {
            var file = e.target.files[0];
            var preview = document.getElementById('previewPoster');

            if (file) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    preview.src = e.target.result;
                    preview.style.display = 'block';
                }
                reader.readAsDataURL(file);
            } else {
                preview.style.display = 'none';
            }
        });

        document.querySelector('form').addEventListener('submit', function() {
            var inputDV = document.getElementById('inputDienVien');
            if (!inputDV.value.trim()) {
                inputDV.value = "---";
            }
        });
    </script>
}