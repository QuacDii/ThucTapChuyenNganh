@model TTCN.Models.Phim
@{
    ViewData["Title"] = "Cập nhật Phim";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var allTheLoais = ViewBag.AllTheLoais as List<TTCN.Models.TheLoai>;
    var selectedTheLoais = ViewBag.Select as List<int>;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>

<div class="container-fluid">
    <div class="card shadow mb-4 border-0">
        <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom-primary">
            <h5 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-edit mr-2"></i> Cập nhật thông tin Phim
            </h5>
        </div>
        <div class="card-body">
            <form asp-action="sua" method="post" enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="MaPhim" />
                <input type="hidden" asp-for="PosterPhim" />

                <div class="row">
                    <div class="col-lg-8">

                        <div class="form-group mb-3">
                            <label asp-for="TenPhim" class="form-label fw-bold"></label>
                            <input asp-for="TenPhim" class="form-control" placeholder="Nhập tên phim..." />
                            <span asp-validation-for="TenPhim" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="DaoDien" class="form-label fw-bold"></label>
                                    <input asp-for="DaoDien" class="form-control" />
                                    <span asp-validation-for="DaoDien" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="DienVien" class="form-label fw-bold"></label>
                                <input asp-for="DienVien" class="form-control" id="inputDienVienSua" placeholder="Nhập tên các diễn viên..." />
                                <span asp-validation-for="DienVien" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="ThoiLuong" class="form-label fw-bold"></label>
                                    <div class="input-group">
                                        <input asp-for="ThoiLuong" class="form-control" />
                                        <span class="input-group-text">phút</span>
                                    </div>
                                    <span asp-validation-for="ThoiLuong" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="NgayPhatHanh" class="form-label fw-bold"></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white"><i class="far fa-calendar-alt"></i></span>
                                        <input asp-for="NgayPhatHanh" class="form-control bg-white" type="text" id="ngayPhatHanh"
                                               value="@(Model.NgayPhatHanh?.ToString("yyyy-MM-dd"))" placeholder="Chọn ngày..." />
                                    </div>
                                    <span asp-validation-for="NgayPhatHanh" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label asp-for="NgayKetThuc" class="form-label fw-bold"></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white"><i class="far fa-calendar-alt"></i></span>
                                        <input asp-for="NgayKetThuc" class="form-control bg-white" type="text" id="ngayKetThuc"
                                               value="@(Model.NgayKetThuc?.ToString("yyyy-MM-dd"))" placeholder="Chọn ngày..." />
                                    </div>
                                    <span asp-validation-for="NgayKetThuc" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="MoTa" class="form-label fw-bold"></label>
                            <textarea asp-for="MoTa" class="form-control" rows="5"></textarea>
                            <span asp-validation-for="MoTa" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold d-block">Thể loại (Chọn nhiều)</label>
                            <div class="card card-body bg-light border-0" style="max-height: 200px; overflow-y: auto;">
                                <div class="row">
                                    @if (allTheLoais != null)
                                    {
                                        foreach (var item in allTheLoais)
                                        {
                                            bool isChecked = selectedTheLoais != null && selectedTheLoais.Contains(item.MaTheLoai);
                                            <div class="col-md-4 col-6 mb-2">
                                                <div class="form-check">
                                                    <input type="checkbox" class="form-check-input" name="select" value="@item.MaTheLoai" id="genre_@item.MaTheLoai"
                                                           @(isChecked ? "checked" : "")>
                                                    <label class="form-check-label user-select-none" for="genre_@item.MaTheLoai">@item.TenTheLoai</label>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="card shadow-sm mb-3">
                            <div class="card-header bg-light fw-bold text-gray-800">
                                Poster Phim
                            </div>
                            <div class="card-body text-center">
                                <div class="mb-3 text-start">
                                    <input type="file" name="fPoster" class="form-control" id="inputPoster" accept="image/*" />
                                    <small class="text-muted">Chọn file mới để thay đổi poster.</small>
                                </div>

                                <div class="preview-box border rounded p-1 d-flex align-items-center justify-content-center bg-light" style="min-height: 300px;">
                                    @{
                                        string imgSrc = "https://via.placeholder.com/200x300?text=No+Image";
                                        if (!string.IsNullOrEmpty(Model.PosterPhim))
                                        {
                                            imgSrc = "/" + Model.PosterPhim;
                                        }
                                    }
                                    <img id="imgPreview" src="@imgSrc" class="img-fluid rounded shadow-sm"
                                         style="max-height: 400px; object-fit: contain;"
                                         onerror="this.src='https://via.placeholder.com/200x300?text=Error';" />
                                </div>
                                <small class="text-muted mt-2 d-block fst-italic">Hình ảnh hiện tại / Xem trước</small>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="TrailerPhim" class="form-label fw-bold"></label>
                            <input type="file" name="fTrailer" id="inputTrailer" class="form-control" accept="video/*" />

                            <div class="mt-2">
                                <video id="videoPreview" width="100%" height="300" controls class="border rounded bg-black" style="display: none;">
                                    @if (Model != null && !string.IsNullOrEmpty(Model.TrailerPhim) && Model.TrailerPhim.Contains("trailers/"))
                                    {
                                        <source src="/@Model.TrailerPhim" type="video/mp4">
                                        <script>document.getElementById('videoPreview').style.display = 'block';</script>
                                    }
                                </video>
                            </div>  
                        </div>

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">Trạng thái hiện tại</label>
                            <input type="text" class="form-control bg-white" readonly value="@Model.TrangThai" />
                            <small class="text-muted fst-italic">* Trạng thái sẽ tự động cập nhật dựa trên ngày chiếu.</small>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end pb-3">
                    <a asp-action="Index" class="btn btn-secondary px-4 me-2 shadow-sm">
                        <i class="fas fa-arrow-left mr-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary px-4 shadow-sm font-weight-bold">
                        <i class="fas fa-save mr-1"></i> Lưu thay đổi
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // --- 1. CẤU HÌNH LỊCH (FLATPICKR) ---
            const config = {
                locale: "vn",
                dateFormat: "Y-m-d",
                altInput: true,
                altFormat: "d/m/Y",
                allowInput: true
            };

            const startPicker = flatpickr("#ngayPhatHanh", {
                ...config,
                onChange: function (selectedDates, dateStr, instance) {
                    // Khi chọn ngày bắt đầu -> Cập nhật ngày tối thiểu cho ngày kết thúc
                    endPicker.set('minDate', dateStr);
                }
            });

            const endPicker = flatpickr("#ngayKetThuc", {
                ...config
            });


            // --- 2. XỬ LÝ PREVIEW ẢNH POSTER ---
            const inputPoster = document.getElementById('inputPoster'); 
            const imgPreview = document.getElementById('imgPreview');   

            if (inputPoster && imgPreview) {
                inputPoster.addEventListener('change', function (e) {
                    const file = e.target.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            imgPreview.src = e.target.result;
                            imgPreview.style.display = 'block';
                        }
                        reader.readAsDataURL(file);
                    }
                });
            }


            // --- 3. XỬ LÝ PREVIEW TRAILER VIDEO ---
            const inputTrailer = document.getElementById('inputTrailer'); 
            const videoPreview = document.getElementById('videoPreview');

            if (inputTrailer && videoPreview) {
                inputTrailer.addEventListener('change', function (e) {
                    const file = e.target.files[0];

                    if (file) {
                        // Kiểm tra dung lượng
                        const limit = 200 * 1024 * 1024;
                        if(file.size > limit) {
                            alert("File quá lớn! Vui lòng chọn video dưới 200MB.");
                            this.value = ""; // Xóa file đã chọn
                            return;
                        }

                        // Tạo URL tạm thời để xem trước video
                        const videoUrl = URL.createObjectURL(file);
                        videoPreview.src = videoUrl;
                        videoPreview.style.display = 'block'; // Hiện khung video
                        videoPreview.load(); // Load lại player
                    } else {
                        videoPreview.style.display = 'none';
                    }
                });
            }
        });

        document.querySelector('form').addEventListener('submit', function() {
            var inputDVSua = document.getElementById('inputDienVienSua');
            if (inputDVSua && !inputDVSua.value.trim()) {
                inputDVSua.value = "---";
            }
        });
    </script>
}