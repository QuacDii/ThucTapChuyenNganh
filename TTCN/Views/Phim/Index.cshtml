@model IEnumerable<TTCN.Models.Phim>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Quản lý Phim";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>

<style>
    .desc-truncate {
        max-width: 250px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        font-size: 0.9rem;
        color: #555;
    }

    .title-truncate {
        max-width: 150px;
        font-weight: 600;
        color: #2e59d9;
    }

    .poster-thumb {
        width: 60px;
        height: 90px;
        object-fit: cover;
        border-radius: 5px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        transition: transform 0.2s;
    }

        .poster-thumb:hover {
            transform: scale(1.5); 
            z-index: 10;
        }

    .table thead th {
        background-color: #4e73df; 
        color: white;
        border: none;
        white-space: nowrap;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
    }
</style>

<div class="container-fluid">
    <div class="card shadow mb-4 border-0">
        <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom-primary">
            <h5 class="m-0 font-weight-bold text-primary"><i class="fas fa-film mr-2"></i> Danh sách Phim</h5>
            <a asp-action="them" class="btn btn-primary btn-icon-split shadow-sm">
                <span class="icon text-white-50">
                    <i class="fas fa-plus"></i>
                </span>
                <span class="text">Thêm Phim Mới</span>
            </a>
        </div>
    <div class="card-body">
            <form asp-action="Index" method="get" class="mb-5">
                <div class="d-flex align-items-center flex-wrap">
                    <div class="input-group me-2" style="width: 200px;">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="fas fa-search text-gray-400"></i>
                        </span>
                        <input type="text" name="search" value="@ViewBag.CurrentSearch"
                               class="form-control border-start-0"
                               placeholder="Tìm tên phim...">
                    </div>

                    <div class="input-group me-2" style="width: 180px;">
                        <span class="input-group-text bg-light border-end-0">
                            <i class="far fa-calendar-alt text-gray-400"></i>
                        </span>
                        <input type="text" id="ngayChieuInput" name="ngay"
                               value="@ViewBag.CurrentDate"
                               class="form-control text-center"
                               placeholder="Ngày chiếu...">
                    </div>

                    <div class="me-2" style="width: 180px;">
                        <select name="trangThai" class="form-control form-select bg-light">
                            <option value="">-- Trạng thái --</option>
                            <option value="Đang công chiếu" selected="@(ViewBag.CurrentStatus == "Đang công chiếu")">Đang công chiếu</option>
                            <option value="Sắp công chiếu" selected="@(ViewBag.CurrentStatus == "Sắp công chiếu")">Sắp công chiếu</option>
                            <option value="Đã chiếu" selected="@(ViewBag.CurrentStatus == "Đã chiếu")">Đã chiếu</option>
                        </select>
                    </div>

                    <div class="me-2" style="width: 300px;">
                        <select name="maTheLoai" class="form-control bg-light select2-multi" multiple="multiple" style="width: 100%">
                            @if (ViewBag.AllTheLoais != null)
                            {
                                var selectedIds = ViewBag.CurrentGenre as List<int> ?? new List<int>();
                                foreach (var tl in ViewBag.AllTheLoais)
                                {
                                    if (selectedIds.Contains(tl.MaTheLoai))
                                    {
                                        <option value="@tl.MaTheLoai" selected>@tl.TenTheLoai</option>
                                    }
                                    else
                                    {
                                        <option value="@tl.MaTheLoai">@tl.TenTheLoai</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary shadow-sm px-3">
                        <i class="fas fa-filter text-white-50"></i> Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary border shadow-sm ms-2" title="Tải lại">
                        <i class="fas fa-sync-alt"></i>
                    </a>

                    <div class="border-end mx-3" style="height: 24px;"></div>

                    <div class="d-flex align-items-center text-nowrap">
                        <span class="text-muted small">Tổng:</span>
                        <span class="badge bg-light text-dark border ms-2 me-1 px-2 py-1">
                            @(Model != null ? Model.Count() : 0)
                        </span>
                        <span class="text-muted small">phim</span>
                    </div>

                </div>
            </form>
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr class="text-center">
                            <th style="width: 50px;">
                                @Html.DisplayNameFor(model => model.FirstOrDefault().MaPhim)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.FirstOrDefault().TenPhim)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.FirstOrDefault().MoTa)
                            </th>

                            <th style="width: 80px;">
                                @Html.DisplayNameFor(model => model.FirstOrDefault().ThoiLuong)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.FirstOrDefault().NgayPhatHanh)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.FirstOrDefault().NgayKetThuc)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.FirstOrDefault().DaoDien)
                            </th>

                            <th>
                                @Html.DisplayNameFor(model => model.FirstOrDefault().DienVien)
                            </th>

                            <th>Thể loại</th>
                            <th style="width: 80px;">
                                @Html.DisplayNameFor(model => model.FirstOrDefault().PosterPhim)
                            </th>
                            <th style="width: 60px;">
                                @Html.DisplayNameFor(model => model.FirstOrDefault().TrailerPhim)
                            </th>
                            <th style="width: 120px;">
                                @Html.DisplayNameFor(model => model.FirstOrDefault().TrangThai)
                            </th>
                            <th style="width: 100px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model.OrderByDescending(x=> x.NgayPhatHanh))
                            {
                                <tr>
                                    <td class="text-center font-weight-bold">
                                        @item.MaPhim
                                    </td>

                                    <td class="title-truncate">
                                        @item.TenPhim
                                    </td>

                                    <td>
                                        <div class="desc-truncate" title="@item.MoTa">
                                            @item.MoTa
                                        </div>
                                    </td>

                                    <td class="text-center">@item.ThoiLuong phút</td>

                                    <td class="text-center">
                                        @item.NgayPhatHanh.Value.ToString("dd/MM/yyyy")
                                    </td>

                                    <td class="text-center">
                                        @item.NgayKetThuc.Value.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>@item.DaoDien</td>

                                    <td>
                                        <div class="desc-truncate" title="@item.DienVien">
                                            @(string.IsNullOrEmpty(item.DienVien) ? "---" : item.DienVien)
                                        </div>
                                    </td>

                                    <td>
                                        @if (item.PhimTheLoais != null && item.PhimTheLoais.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1">
                                                @foreach (var ct in item.PhimTheLoais)
                                                {
                                                    <span class="badge bg-light text-dark border mr-1 mb-1">@ct.MaTheLoaiNavigation?.TenTheLoai</span>
                                                }
                                            </div>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.PosterPhim))
                                        {
                                            var imgSrc = "/" + item.PosterPhim;
                                            <img src="@imgSrc" alt="Poster" class="poster-thumb"
                                                 onerror="this.onerror=null;this.src='https://via.placeholder.com/60x90?text=No+Img';" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No Image</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @if (!string.IsNullOrEmpty(item.TrailerPhim))
                                        {
                                            if (item.TrailerPhim.Contains("trailers/"))
                                            {
                                                <button type="button"
                                                        class="btn btn-danger btn-circle btn-sm shadow-sm btn-view-trailer"
                                                        data-trailer="@item.TrailerPhim"
                                                        title="Xem Trailer">
                                                    <i class="fas fa-play"></i>
                                                </button>
                                            }
                                        }
                                    </td>

                                    <td class="text-center align-middle">
                                        @if (item.TrangThai == "Đang công chiếu")
                                        {
                                            <span class="badge bg-success w-100 py-2">@item.TrangThai</span>
                                        }
                                        else if (item.TrangThai == "Sắp công chiếu")
                                        {
                                            <span class="badge bg-warning text-dark w-100 py-2">@item.TrangThai</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary w-100 py-2">@item.TrangThai</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="sua" asp-route-id="@item.MaPhim" class="btn btn-outline-warning btn-sm shadow-sm" title="Sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="xoa" asp-route-id="@item.MaPhim" class="btn btn-outline-danger btn-sm shadow-sm">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="text-center py-5">
                                    <p class="text-muted mb-0">Chưa có dữ liệu phim nào.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="trailerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark">
            <div class="modal-header border-0">
                <h5 class="modal-title text-white">Trailer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0 text-center" id="trailerModalBody">
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <style>
        .select2-container .select2-selection--multiple {
            min-height: 38px !important;
            border: 1px solid #d1d3e2 !important;
            padding: 4px !important;
        }

        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            background-color: #4e73df !important; 
            color: white !important;
            border: none !important;
            border-radius: 4px !important;
            padding: 3px 8px !important;
            margin-top: 3px !important;
            margin-right: 5px !important;
            display: inline-flex !important;
            flex-direction: row-reverse !important; 
            align-items: center !important;
            gap: 6px !important; 
        }

        .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
            color: rgba(255,255,255,0.8) !important;
            margin: 0 !important;
            padding: 0 !important;
            border: none !important;
            float: none !important; 
            background: transparent !important;
            font-size: 16px !important;
            font-weight: bold !important;
            line-height: 1 !important;
            position: static !important; 
        }

            .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover {
                color: #fff !important;
                background-color: transparent !important;
            }
    </style>

    <script>
        $(document).ready(function() {
            $('.select2-multi').select2({
                placeholder: "Chọn thể loại (có thể chọn nhiều)",
                allowClear: true,
                closeOnSelect: false, 
                width: 'resolve' 
            });
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            flatpickr("#ngayChieuInput", {
                locale: "vn",
                dateFormat: "Y-m-d", 
                altInput: true,        
                altFormat: "d/m/Y",    
                allowInput: true,       
                disableMobile: "true"   
            });

            // Lấy Modal và Body của Modal
            var trailerModal = document.getElementById('trailerModal');
            var modalBody = document.getElementById('trailerModalBody');

            // Bắt sự kiện khi click vào bất kỳ nút ".btn-view-trailer" nào
            document.querySelectorAll('.btn-view-trailer').forEach(button => {
                button.addEventListener('click', function() {
                    var trailerPath = this.getAttribute('data-trailer');
                    var htmlContent = '';

                    // LOGIC KIỂM TRA LOẠI VIDEO

                    // 1. Nếu là File Video Upload (chứa chữ "trailers/")
                    if (trailerPath.includes('trailers/')) {
                        // Thêm dấu / đầu tiên để trỏ về thư mục root
                        var videoUrl = trailerPath.startsWith('/') ? trailerPath : '/' + trailerPath;

                        htmlContent = `
                            <video width="100%" controls autoplay class="rounded">
                                <source src="${videoUrl}" type="video/mp4">
                                Trình duyệt của bạn không hỗ trợ thẻ video.
                            </video>
                        `;
                    }

                    // Chèn nội dung vào Modal và hiện lên
                    modalBody.innerHTML = htmlContent;
                    var myModal = new bootstrap.Modal(trailerModal);
                    myModal.show();
                });
            });

            // Khi đóng Modal -> Xóa nội dung để video dừng phát
            trailerModal.addEventListener('hidden.bs.modal', function () {
                modalBody.innerHTML = '';
            });
        });
    </script>
}