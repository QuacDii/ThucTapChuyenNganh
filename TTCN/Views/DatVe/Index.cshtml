<!DOCTYPE html>
@using System.Linq
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đặt Vé</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="~/css/site3.css" rel="stylesheet" />
    <style>
        .combo-item-card {
            background-color: #f8f9fa;
            transition: all 0.2s;
        }
        .combo-item-card:hover {
            background-color: #e9ecef;
            border-color: #dee2e6 !important;
        }
            /* Mặc định: combo CHƯA chọn */
            .combo-item-card label {
                color: #212529; /* đen bootstrap */
                opacity: 1;
            }

            /* Khi checkbox được chọn */
            .combo-item-card input[type="checkbox"]:checked + label {
                color: #198754; /* xanh */
                font-weight: 600;
            }

        #combo-list-container {
            scrollbar-width: thin;
        }
        #combo-list-container::-webkit-scrollbar {
            width: 6px;
        }
        #combo-list-container::-webkit-scrollbar-thumb {
            background-color: #6c757d;
            border-radius: 3px;
        }
        /* ===== CHECKBOX COMBO – TRẠNG THÁI CHƯA CHỌN ===== */
        .combo-check {
            width: 22px;
            height: 22px;
            cursor: pointer;
            /* CHƯA CHỌN */
            background-color: #ffffff;
            border: 2px solid #6c757d; /* xám đậm – dễ thấy */
            border-radius: 6px;
            transition: all 0.2s ease;
        }

            /* Hover khi chưa chọn */
            .combo-check:hover {
                border-color: #198754;
                background-color: #f0fdf4; /* xanh rất nhạt */
                box-shadow: 0 0 0 3px rgba(25,135,84,0.15);
            }

            /* ===== KHI CHECK ===== */
            .combo-check:checked {
                background-color: #198754;
                border-color: #198754;
            }

                /* Dấu tick to – rõ */
                .combo-check:checked::before {
                    transform: scale(1.25);
                }

        /* ===== LABEL ===== */
        .combo-item-card label {
            color: #212529; /* chữ rõ khi chưa chọn */
            opacity: 1;
        }

        /* Label khi đã chọn */
        .combo-item-card input[type="checkbox"]:checked + label {
            color: #198754;
            font-weight: 700;
        }

        /* ===== CARD COMBO NỔI BẬT ===== */
        .combo-item-card {
            background-color: #f8f9fa;
            transition: all 0.2s ease;
        }

            .combo-item-card:hover {
                background-color: #eef1f4;
                border-color: #ced4da !important;
            }

            /* Khi combo được chọn */
            .combo-item-card:has(.combo-check:checked) {
                background-color: #e9f7ef;
                border-color: #198754 !important;
                box-shadow: 0 4px 14px rgba(25,135,84,0.25);
            }
        
        /* ===== HÌNH ẢNH COMBO ===== */
        .combo-image-wrapper {
            width: 100px;
            height: 100px;
            flex-shrink: 0;
        }
        
        .combo-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 8px;
            border: 2px solid #dee2e6;
            transition: all 0.2s ease;
        }
        
        .combo-item-card:hover .combo-image {
            border-color: #198754;
            transform: scale(1.05);
        }
        
        .combo-item-card:has(.combo-check:checked) .combo-image {
            border-color: #198754;
            box-shadow: 0 2px 8px rgba(25,135,84,0.3);
        }
        
        .combo-image-placeholder {
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border: 2px dashed #ced4da;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6c757d;
            font-size: 24px;
        }
        
        .combo-item-card:has(.combo-check:checked) .combo-image-placeholder {
            border-color: #198754;
            background: linear-gradient(135deg, #e9f7ef 0%, #d1f2eb 100%);
            color: #198754;
        }
        
        /* ===== THÔNG TIN COMBO ===== */
        .combo-name {
            font-size: 15px;
            line-height: 1.4;
            display: block;
            margin-bottom: 4px;
        }
        
        .combo-price-wrapper {
            margin-top: 4px;
        }
        /* ===== WRAPPER ===== */
            /* Label "Số lượng" */
            .qty-wrapper label {
                font-size: 14px;
                font-weight: 600;
                color: #198754;
                margin-bottom: 0;
            }

            /* ===== INPUT GROUP ===== */
            .qty-wrapper .input-group {
                width: 120px;
                border-radius: 999px;
                overflow: hidden;
                background: #ffffff;
                border: 1px solid #198754;
            }

            /* ===== BUTTON +/- ===== */
            .qty-wrapper .btn {
                width: 34px;
                height: 34px;
                padding: 0;
                border: none;
                background: #e9f7ef;
                color: #198754;
                font-size: 18px;
                font-weight: 700;
                transition: all 0.15s ease;
            }

                .qty-wrapper .btn:hover {
                    background: #198754;
                    color: #ffffff;
                }

            /* ===== INPUT SỐ ===== */
            .qty-wrapper .combo-qty-input {
                border: none;
                text-align: center;
                font-weight: 700;
                font-size: 15px;
                color: #212529;
                background: transparent;
                pointer-events: none; /* chỉ dùng nút +/- */
            }

        /* ===== KHI COMBO ĐƯỢC CHỌN ===== */
        .combo-item-card:has(.combo-check:checked) .qty-wrapper {
            background: #e9f7ef;
            border-color: #198754;
        }
    </style>
</head>
<body>

    <header class="movie-header">
        <div class="container">
            @foreach (var item in ViewBag.dlPhimDaChon)
            {
                <h1>@item.TenPhim</h1>
                <span>@item.ThoiLuong phút</span>
                <span>| @string.Join(", ", item.TenTheLoai)</span>
            }
        </div>
    </header>

    <div class="container-fluid my-4">
        <div class="row">

            <div class="col-lg-8">
                @{
                    // 1. Ép kiểu ViewBag về Model Phim để code hiểu
                    var phim = ViewBag.dlSuatChieu as TTCN.Models.Phim;
                    // 2. Gom nhóm các suất chiếu theo Cụm Rạp
                    var danhSachRap = phim.SuatChieus
                    .GroupBy(sc => sc.MaPhongNavigation.MaCumRapNavigation)
                    .Select(g => g.Key)
                    .ToList();
                }
                <div class="showtime-selector">
                    <div class="filter-header mb-4">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="filter-label">Khu vực</label>
                                <div class="select-wrapper">
                                    <select class="form-select custom-select" id="area-select" onchange="handleAreaChange(true)">
                                        <option value="" selected disabled>Chọn khu vực</option>
                                        @foreach (var rap in danhSachRap.Select(r => r.ThanhPho).Distinct())
                                        {
                                            <option>@rap</option>
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="filter-label">Cụm rạp</label>
                                <div class="select-wrapper">
                                    <select class="form-select custom-select" id="cinema-select" onchange="updateCinemaInfo(true)">
                                        <option value="" data-id="" selected>Chọn cụm rạp</option>
                                        @foreach (var rap in danhSachRap)
                                        {
                                            <option value="@rap.TenCumRap" data-id="@rap.MaCumRap" data-area="@rap.ThanhPho">@rap.TenCumRap</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr class="border-secondary mb-4">
                    <h6>Chọn Ngày</h6>
                    <ul class="nav nav-pills mb-3" id="pills-tab-date" role="tablist">
                        @{
                            int active = 0;
                        }
                        @foreach (var item in ViewBag.dlPhimDaChon)
                        {
                            @foreach (var ngay in @item.CacNgayChieu)
                            {
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link date-btn @(active == 0 ? "active" : "")"
                                            type="button" onclick="filterShowtimeByDate(this, '@ngay.ToString("yyyy-MM-dd")')">
                                        <span class="day-num">@ngay.ToString("dd")</span>
                                        <span class="day-month">/@ngay.ToString("MM")</span>
                                    </button>
                                </li>
                                { active++; }
                            }
                        }
                    </ul>
                    <div class="showtime-list-container">
                        @{
                            var nhomTheoRap = phim.SuatChieus.GroupBy(s => s.MaPhongNavigation.MaCumRapNavigation);
                        }
                        @foreach (var rapGroup in nhomTheoRap)
                        {
                            <div class="cinema-block" data-cinema-id="@rapGroup.Key.MaCumRap" data-area="@rapGroup.Key.ThanhPho">
                                <div class="cinema-title-row">
                                    <div class="cinema-icon"><i class="fas fa-map-marker-alt"></i></div>
                                    <h5 class="cinema-name">@rapGroup.Key.TenCumRap</h5>
                                </div>
                                <div class="rooms-container">
                                    @{
                                        var nhomTheoPhong = rapGroup.GroupBy(s => s.MaPhongNavigation);
                                    }

                                    @foreach (var phongGroup in nhomTheoPhong)
                                    {
                                        <div class="room-row">
                                            <div class="room-label">
                                                <span>@phongGroup.Key.TenPhong</span>
                                            </div>
                                            <div class="time-slots">
                                                @foreach (var suat in phongGroup.OrderBy(s => s.GioBatDau))
                                                {
                                                    <button class="btn-time-slot"
                                                            type="button"
                                                            data-date="@suat.GioBatDau.Value.ToString("yyyy-MM-dd")"
                                                            data-room="@phongGroup.Key.TenPhong"
                                                            data-time="@suat.GioBatDau.Value.ToString("HH:mm")"
                                                            data-suat-id="@suat.MaSuat"
                                                            data-display-date="@suat.GioBatDau.Value.ToString("dd/MM/yyyy")"
                                                            onclick="selectShowtime(this)">
                                                        @suat.GioBatDau.Value.ToString("HH:mm")
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="seat-selection mt-5">
                    <div class="screen-text">MÀN HÌNH</div>
                    <div class="screen"></div>
                    <div id="seat-map-container" class="seat-map mt-4"></div>
                    <div class="legend mt-4">
                        <div class="legend-item"><div class="seat standard"></div><span>Trống</span></div>
                        <div class="legend-item"><div class="seat sweetbox"></div><span>Sweetbox</span></div>
                        <div class="legend-item"><div class="seat selected"></div><span>Đang chọn</span></div>
                        <div class="legend-item"><div class="seat occupied"></div><span>Đã bán</span></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="booking-summary">
                    <div class="mb-3 clearfix">

                        <div class="summary-details">
                            @foreach (var item in ViewBag.dlPhimDaChon)
                            {
                                <h4 class="mb-1">@item.TenPhim</h4>
                            }
                            <p id="sum-cinema"><strong>Rạp:</strong> Chưa chọn</p>
                            <p id="sum-room"><strong>Phòng:</strong> Chưa chọn</p>
                            <p id="sum-date"><strong>Ngày:</strong> --/--/----</p>
                            <p id="sum-time"><strong>Giờ:</strong> --:--</p>

                        </div>
                    </div>

                    <hr>

                    <div class="mb-3">
                        <h5>Ghế đã chọn (<span id="seat-count">0</span>)</h5>
                        <ul id="selected-seats-list">
                        </ul>
                    </div>

                    <hr>

                    <div class="mb-3">
                        <h5>Combo đã chọn</h5>
                        <ul id="selected-combo-list">
                        </ul>
                    </div>

                    <hr>

                    <div class="mb-3">
                        <h5>Chọn Combo</h5>
                        <div id="combo-list-container" style="max-height: 400px; overflow-y: auto;">
                            @if (ViewBag.doAn != null)
                            {
                                @foreach (var combo in ViewBag.doAn as IEnumerable<TTCN.Models.DoAn>)
                                {
                                    <div class="combo-item-card mb-2 p-3 border rounded" data-combo-id="@combo.MaCombo" data-combo-price="@combo.Gia">
                                        <div class="d-flex align-items-start">
                                            <!-- Checkbox -->
                                            <input type="checkbox"
                                                   class="form-check-input me-3 mt-2 combo-checkbox combo-check"
                                                   id="combo-@combo.MaCombo" 
                                                   data-combo-id="@combo.MaCombo"
                                                   data-combo-text="@combo.MoTa"
                                                   data-combo-price="@combo.Gia">
                                            
                                            <!-- Hình ảnh combo -->
                                            <div class="combo-image-wrapper me-3 flex-shrink-0">
                                                @if (!string.IsNullOrEmpty(combo.HinhAnh))
                                                {
                                                    <img src="@combo.HinhAnh" alt="@combo.MoTa" class="combo-image" onerror="this.src='https://via.placeholder.com/80x80?text=Combo'">
                                                }
                                                else
                                                {
                                                    <div class="combo-image-placeholder">
                                                        <i class="fas fa-image"></i>
                                                    </div>
                                                }
                                            </div>
                                            
                                            <!-- Thông tin combo -->
                                            <div class="flex-grow-1">
                                                <label class="form-check-label mb-1 d-block" for="combo-@combo.MaCombo">
                                                    <strong class="combo-name">@combo.MoTa</strong>
                                                </label>
                                                <div class="combo-price-wrapper">
                                                    <span class="text-danger fw-bold">@combo.Gia.ToString("#,##0")đ</span>
                                                </div>
                                                
                                                <!-- Số lượng -->
                                                <div class="combo-quantity-control mt-2 qty-wrapper" style="display: none;">
                                                    <label class="small me-2">Số lượng:</label>
                                                    <div class="input-group input-group-sm" style="width: 130px;">
                                                        <button class="btn btn-outline-secondary combo-qty-decrease" type="button" data-combo-id="@combo.MaCombo">-</button>
                                                        <input type="number" class="form-control text-center combo-qty-input" 
                                                               data-combo-id="@combo.MaCombo"
                                                               value="1" min="1" max="10">
                                                        <button class="btn btn-outline-secondary combo-qty-increase" type="button" data-combo-id="@combo.MaCombo">+</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    </div>

                    <hr>

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">TỔNG CỘNG</h5>
                        <span class="total-price" id="total-price">0đ</span>
                    </div>

                    <form id="checkout-form" asp-action="Index" asp-controller="Payment" method="post">
                        <input type="hidden" name="MovieName" id="payment-movie-name" value="@(((IEnumerable<dynamic>)ViewBag.dlPhimDaChon)?.FirstOrDefault()?.TenPhim ?? string.Empty)" />
                        <input type="hidden" name="CinemaName" id="payment-cinema" />
                        <input type="hidden" name="RoomName" id="payment-room" />
                        <input type="hidden" name="ShowDate" id="payment-date" />
                        <input type="hidden" name="ShowTime" id="payment-time" />
                        <input type="hidden" name="SelectedSeatsJson" id="payment-seats-json" />
                        <input type="hidden" name="ComboText" id="payment-combo-text" />
                        <input type="hidden" name="ComboPrice" id="payment-combo-price" />
                        <input type="hidden" name="ComboQuantity" id="payment-combo-quantity" />
                        <input type="hidden" name="SelectedCombosJson" id="payment-combos-json" />
                        <input type="hidden" name="TotalPrice" id="payment-total-price" />
                        <input type="hidden" name="MaSuat" id="payment-masuat" />
                        <button type="button" class="btn btn-checkout w-100" id="btn-checkout">
                            Thanh Toán
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script>
        const seatApiUrl = '@Url.Action("GetGheBySuatChieu", "DatVe")';
        let selectedSeats = [];
        let currentMaSuat = 0;
        let currentSelectedDate = null;
        let currentTotalPrice = 0;
        let selectedCombos = []; // Mảng các combo đã chọn: {maCombo, text, price, quantity}
        let summaryInfo = {
            movie: document.getElementById('payment-movie-name')?.value || '',
            cinema: 'Chưa chọn',
            room: 'Chưa chọn',
            date: '',
            time: ''
        };

        function renderSeatMap(maSuat) {
            currentMaSuat = maSuat;
            selectedSeats = [];
            updateCartUI();


            const container = document.getElementById('seat-map-container');
            if (!container) return;

            container.innerHTML = '<div class="text-center text-light"><div class="spinner-border text-danger" role="status"></div><br>Đang tải sơ đồ ghế...</div>';
            $.ajax({
                url: seatApiUrl,
                type: 'GET',
                data: { maSuat: maSuat },
                success: function (data) {
                    console.log("API data:", data);
                    container.innerHTML = '';

                    if (!Array.isArray(data) || data.length === 0) {
                        container.innerHTML = '<p class="text-white text-center">Phòng này chưa có sơ đồ ghế.</p>';
                        return;
                    }

                    const rows = {};
                    data.forEach(ghe => {
                        const hang = ghe.hangGhe || ghe.HangGhe;
                        if (!rows[hang]) {
                            rows[hang] = [];
                        }
                        rows[hang].push(ghe);
                    });

                    Object.keys(rows).sort().forEach(hang => {
                        const rowDiv = document.createElement('div');
                        rowDiv.className = 'seat-row mb-2';
                        const labelDiv = document.createElement('div');
                        labelDiv.className = 'row-label';
                        labelDiv.innerText = hang;
                        rowDiv.appendChild(labelDiv);

                        const sortedSeats = rows[hang]
                            .sort((a, b) => {
                                const nameA = (a.tenGhe || a.TenGhe || '').trim();
                                const nameB = (b.tenGhe || b.TenGhe || '').trim();
                                return nameA.localeCompare(nameB, undefined, { numeric: true, sensitivity: 'base' });
                            });

                        const isSweetboxRow = sortedSeats.length > 0 &&
                            sortedSeats.every(ghe => {
                                const loai = (ghe.loaiGhe || ghe.LoaiGhe || '').toUpperCase();
                                return loai === 'SWEETBOX';
                            });

                        if (isSweetboxRow) {
                            for (let i = 0; i < sortedSeats.length; i += 2) {
                                const firstSeat = sortedSeats[i];
                                const secondSeat = sortedSeats[i + 1];
                                if (!firstSeat || !secondSeat) continue;

                                const seatBtn = document.createElement('button');
                                seatBtn.className = 'seat sweetbox';
                                const firstName = (firstSeat.tenGhe || firstSeat.TenGhe || '').trim();
                                const secondName = (secondSeat.tenGhe || secondSeat.TenGhe || '').trim();
                                const sweetboxLabel = `${firstName}-${secondName}`;
                                seatBtn.innerText = sweetboxLabel;

                                const firstOccupied = firstSeat.daDat ?? firstSeat.DaDat;
                                const secondOccupied = secondSeat.daDat ?? secondSeat.DaDat;

                                if (firstOccupied || secondOccupied) {
                                    seatBtn.classList.add('occupied');
                                    seatBtn.disabled = true;
                                } else {
                                    const firstId = firstSeat.maGhe ?? firstSeat.MaGhe;
                                    const secondId = secondSeat.maGhe ?? secondSeat.MaGhe;
                                    const firstPrice = Number(firstSeat.giaGhe ?? firstSeat.GiaGhe ?? 0);
                                    const secondPrice = Number(secondSeat.giaGhe ?? secondSeat.GiaGhe ?? 0);
                                    const totalPrice = firstPrice + secondPrice;

                                    seatBtn.addEventListener('click', () => toggleSweetboxSeat(
                                        seatBtn,
                                        [firstId, secondId],
                                        sweetboxLabel,
                                        totalPrice
                                    ));
                                }

                                rowDiv.appendChild(seatBtn);
                            }
                        } else {
                            sortedSeats.forEach(ghe => {
                                const seatBtn = document.createElement('button');
                                seatBtn.className = 'seat';
                                const tenGhe = (ghe.tenGhe || ghe.TenGhe || '').trim();
                                seatBtn.innerText = tenGhe;

                                const daDat = ghe.daDat ?? ghe.DaDat;
                                if (daDat) {
                                    seatBtn.classList.add('occupied');
                                    seatBtn.disabled = true;
                                } else {
                                    const loaiGhe = (ghe.loaiGhe || ghe.LoaiGhe || '').toUpperCase();
                                    seatBtn.classList.add(loaiGhe === 'VIP' ? 'vip' : 'standard');
                                    const maGhe = ghe.maGhe ?? ghe.MaGhe;
                                    const giaGhe = ghe.giaGhe ?? ghe.GiaGhe ?? 0;
                                    seatBtn.addEventListener('click', () => toggleSeat(seatBtn, maGhe, tenGhe, Number(giaGhe)));
                                }

                                rowDiv.appendChild(seatBtn);
                            });
                        }

                        container.appendChild(rowDiv);
                    });
                },
                error: function () {
                    container.innerHTML = '<p class="text-danger text-center">Lỗi kết nối API.</p>';
                }
            });
        }

        function toggleSeat(btn, maGhe, tenGhe, giaGhe) {
            const seatId = maGhe.toString();
            const index = selectedSeats.findIndex(s => s.id === seatId);

            if (index === -1) {
                if (getSelectedSeatCount() >= 8) {
                    alert('Bạn chỉ được chọn tối đa 8 ghế.');
                    return;
                }
                selectedSeats.push({ id: seatId,seatIds: [seatId], name: tenGhe, price: giaGhe, quantity: 1 });
                btn.classList.add('selected');
            } else {
                selectedSeats.splice(index, 1);
                btn.classList.remove('selected');
            }

            updateCartUI();
        }

        function toggleSweetboxSeat(btn, seatIds, label, totalPrice) {
            const groupId = seatIds.join('_');
            const index = selectedSeats.findIndex(s => s.id === groupId);

            if (index === -1) {
                if (getSelectedSeatCount() + 2 > 8) {
                    alert('Bạn chỉ được chọn tối đa 8 ghế.');
                    return;
                }

                selectedSeats.push({
                    id: groupId,
                    name: label,
                    price: totalPrice,
                    quantity: 2,
                    seatIds
                });
                btn.classList.add('selected');
            } else {
                selectedSeats.splice(index, 1);
                btn.classList.remove('selected');
            }

            updateCartUI();
        }


        function getSelectedSeatCount() {
            return selectedSeats.reduce((total, seat) => total + (seat.quantity || 1), 0);
        }

        function setInputValue(elementId, value) {
            const input = document.getElementById(elementId);
            if (input) {
                input.value = value ?? '';
            }
        }

        function updateCheckoutHiddenFields() {
            setInputValue('payment-cinema', summaryInfo.cinema);
            setInputValue('payment-room', summaryInfo.room);
            setInputValue('payment-date', summaryInfo.date);
            setInputValue('payment-time', summaryInfo.time);
            setInputValue('payment-total-price', currentTotalPrice);
            const seatsPayload = selectedSeats.map(s => ({
                maGhe: (s.seatIds ?? [s.id]).map(x => parseInt(x)),
                name: s.name,
                price: s.price
            }));
            setInputValue('payment-seats-json', JSON.stringify(seatsPayload));

            // Gửi danh sách combo đã chọn dưới dạng JSON
            const combosPayload = selectedCombos.map(c => ({
                maCombo: c.maCombo,
                soLuong: c.quantity
            }));
            setInputValue('payment-combos-json', JSON.stringify(combosPayload));
            
            // Giữ lại các field cũ để tương thích (có thể để trống hoặc lấy combo đầu tiên)
            if (selectedCombos.length > 0) {
                const firstCombo = selectedCombos[0];
                setInputValue('payment-combo-text', firstCombo.text);
                setInputValue('payment-combo-price', firstCombo.price * firstCombo.quantity);
                setInputValue('payment-combo-quantity', firstCombo.quantity);
            } else {
                setInputValue('payment-combo-text', '');
                setInputValue('payment-combo-price', 0);
                setInputValue('payment-combo-quantity', 0);
            }
        }

        function updateCartUI() {
            const listEl = document.getElementById('selected-seats-list');
            const countEl = document.getElementById('seat-count');
            const totalEl = document.getElementById('total-price');
            const comboListEl = document.getElementById('selected-combo-list');
            const btnCheckout = document.querySelector('.btn-checkout');
            if (!listEl || !countEl || !totalEl) return;

            listEl.innerHTML = '';
            let total = 0;
            selectedSeats
                .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true, sensitivity: 'base' }))
                .forEach(s => {
                    total += s.price;
                    listEl.innerHTML += `
                        <li class="d-flex justify-content-between mb-2 text-white">
                            <span>${s.name}</span>
                            <strong>${Number(s.price).toLocaleString('vi-VN')}đ</strong>
                        </li>`;
                });
            // Hiển thị combo đã chọn và tính vào tổng
            let comboTotalPrice = 0;
            if (comboListEl) {
                comboListEl.innerHTML = '';
                if (selectedCombos.length > 0) {
                    selectedCombos.forEach(combo => {
                        const itemTotal = combo.price * combo.quantity;
                        comboTotalPrice += itemTotal;
                        comboListEl.innerHTML += `
                            <li class="d-flex justify-content-between mb-2 text-white">
                                <span>${combo.text} x${combo.quantity}</span>
                                <strong>${itemTotal.toLocaleString('vi-VN')}đ</strong>
                            </li>`;
                    });
                } else {
                    comboListEl.innerHTML = '<li class="text-muted">Chưa chọn combo</li>';
                }
            }
            
            total += comboTotalPrice;
            currentTotalPrice = total;

            const seatCount = getSelectedSeatCount();
            countEl.innerText = seatCount;
            const formattedTotal = total.toLocaleString('vi-VN') + 'đ';
            totalEl.innerText = formattedTotal;
            if (btnCheckout) btnCheckout.disabled = seatCount === 0;
            updateCheckoutHiddenFields();
        }
        
        // Hàm xử lý khi chọn/bỏ chọn combo
        function toggleCombo(checkbox) {
            const comboId = parseInt(checkbox.getAttribute('data-combo-id'), 10);
            const comboText = checkbox.getAttribute('data-combo-text');
            const comboPrice = parseFloat(checkbox.getAttribute('data-combo-price'));
            const quantityControl = checkbox.closest('.combo-item-card').querySelector('.combo-quantity-control');
            const quantityInput = checkbox.closest('.combo-item-card').querySelector('.combo-qty-input');
            
            if (checkbox.checked) {
                // Thêm combo vào danh sách
                selectedCombos.push({
                    maCombo: comboId,
                    text: comboText,
                    price: comboPrice,
                    quantity: 1
                });
                if (quantityControl) quantityControl.style.display = 'block';
                if (quantityInput) quantityInput.value = 1;
            } else {
                // Xóa combo khỏi danh sách
                const index = selectedCombos.findIndex(c => c.maCombo === comboId);
                if (index !== -1) {
                    selectedCombos.splice(index, 1);
                }
                if (quantityControl) quantityControl.style.display = 'none';
                if (quantityInput) quantityInput.value = 1;
            }
            
            updateCartUI();
        }
        
        // Hàm cập nhật số lượng combo
        function updateComboQuantity(comboId, newQuantity) {
            const combo = selectedCombos.find(c => c.maCombo === comboId);
            if (combo) {
                combo.quantity = Math.max(1, Math.min(10, parseInt(newQuantity, 10) || 1));
            }
            updateCartUI();
        }

        function filterCinemaOptions(selectedArea) {
            const cinemaSelect = document.getElementById('cinema-select');
            if (!cinemaSelect) return;

            let firstVisibleIndex = -1;
            Array.from(cinemaSelect.options).forEach((opt, idx) => {
                if (idx === 0) {
                    opt.style.display = '';
                    return;
                }

                const optArea = opt.getAttribute('data-area') || '';
                const matches = !selectedArea || optArea === selectedArea;
                opt.style.display = matches ? '' : 'none';
                if (matches && firstVisibleIndex === -1) {
                    firstVisibleIndex = idx;
                }
                if (!matches && opt.selected) {
                    opt.selected = false;
                }
            });
            if (!cinemaSelect.value && firstVisibleIndex !== -1) {
                cinemaSelect.selectedIndex = firstVisibleIndex;
            }
        }

        function handleAreaChange(shouldResetCinema = true) {
            const areaSelect = document.getElementById('area-select');
            const selectedArea = areaSelect ? areaSelect.value : '';
            filterCinemaOptions(selectedArea);

            if (shouldResetCinema) {
                const cinemaSelect = document.getElementById('cinema-select');
                if (cinemaSelect) {
                    cinemaSelect.selectedIndex = 0;
                }
                document.querySelectorAll('.btn-time-slot').forEach(btn => btn.classList.remove('active'));
                resetSummaryInfo();
                clearSeatMap();
            }
            applyShowtimeFilters();
        }

        function updateCinemaInfo(shouldResetShowtime = true) {
            const cinemaSelect = document.getElementById('cinema-select');
            if (!cinemaSelect) return;

            const selectedOption = cinemaSelect.options[cinemaSelect.selectedIndex];
            const selectedName = selectedOption && selectedOption.value ? selectedOption.text : 'Chưa chọn';
            const selectedArea = selectedOption ? selectedOption.getAttribute('data-area') || '' : '';

            const areaSelect = document.getElementById('area-select');
            if (areaSelect && selectedArea && areaSelect.value !== selectedArea) {
                areaSelect.value = selectedArea;
                filterCinemaOptions(selectedArea);
            }

            const cinemaEl = document.getElementById('sum-cinema');
            if (cinemaEl) cinemaEl.innerHTML = `<strong>Rạp:</strong> ${selectedName}`;
            summaryInfo.cinema = selectedName;
            updateCheckoutHiddenFields();
            if (shouldResetShowtime) {
                document.querySelectorAll('.btn-time-slot').forEach(btn => btn.classList.remove('active'));
                resetSummaryInfo();
                clearSeatMap();
            }

            applyShowtimeFilters();
        }

        function applyShowtimeFilters() {
            const cinemaSelect = document.getElementById('cinema-select');
            const areaSelect = document.getElementById('area-select');
            const selectedOption = cinemaSelect ? cinemaSelect.options[cinemaSelect.selectedIndex] : null;
            const selectedId = selectedOption ? selectedOption.getAttribute('data-id') : '';
            const selectedArea = areaSelect ? areaSelect.value : '';
            const hasCinemaFilter = !!(selectedOption && selectedOption.value);
            const hasAreaFilter = !!selectedArea;
            document.querySelectorAll('.btn-time-slot').forEach(slot => {
                const slotDate = slot.getAttribute('data-date');
                const matchesDate = !currentSelectedDate || slotDate === currentSelectedDate;
                slot.style.display = matchesDate ? 'inline-block' : 'none';
                slot.classList.remove('active');
            });
            document.querySelectorAll('.room-row').forEach(row => {
                const visibleBtns = Array.from(row.querySelectorAll('.btn-time-slot'))
                    .filter(btn => btn.style.display !== 'none');
                row.style.display = visibleBtns.length > 0 ? 'flex' : 'none';
            });
            document.querySelectorAll('.cinema-block').forEach(block => {
                const matchesCinema = !hasCinemaFilter || block.getAttribute('data-cinema-id') === selectedId;
                const matchesArea = !hasAreaFilter || block.getAttribute('data-area') === selectedArea;
                const visibleRooms = Array.from(block.querySelectorAll('.room-row'))
                    .filter(row => row.style.display !== 'none');

                block.style.display = matchesCinema && matchesArea && visibleRooms.length > 0 ? 'block' : 'none';
            });
        }

        // --- HÀM SỬA ĐỔI: Sử dụng btnElement (this) và lấy data-attributes ---
        function selectShowtime(btnElement) {

            // 1. Lấy dữ liệu an toàn từ Data Attribute
            const roomName = btnElement.getAttribute('data-room');
            const time = btnElement.getAttribute('data-time');
            const maSuat = btnElement.getAttribute('data-suat-id');
            const ngayChieu = btnElement.getAttribute('data-display-date');

            // 2. Các logic xử lý bên dưới giữ nguyên
            const cinemaBlock = btnElement.closest('.cinema-block');
            const blockArea = cinemaBlock ? cinemaBlock.getAttribute('data-area') : '';
            const blockCinemaId = cinemaBlock ? cinemaBlock.getAttribute('data-cinema-id') : '';

            const areaSelect = document.getElementById('area-select');
            if (areaSelect && blockArea && areaSelect.value !== blockArea) {
                areaSelect.value = blockArea;
                handleAreaChange(false);
            }

            const cinemaSelect = document.getElementById('cinema-select');
            if (cinemaSelect && blockCinemaId) {
                const matched = Array.from(cinemaSelect.options).find(opt => opt.getAttribute('data-id') === blockCinemaId);
                if (matched) {
                    cinemaSelect.value = matched.value;
                    updateCinemaInfo(false);
                }
            }

            const isAlreadyActive = btnElement.classList.contains('active');
            document.querySelectorAll('.btn-time-slot').forEach(b => b.classList.remove('active'));

            if (isAlreadyActive) {
                resetSummaryInfo();
                clearSeatMap();
                return;
            }

            btnElement.classList.add('active');
            updateBookingInfo(roomName, time, ngayChieu);
            renderSeatMap(maSuat);
            document.getElementById("payment-masuat").value = maSuat;
        }

        // Xử lý checkbox combo
        document.querySelectorAll('.combo-checkbox').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                toggleCombo(this);
            });
        });
        
        // Xử lý nút tăng/giảm số lượng cho từng combo
        document.querySelectorAll('.combo-qty-increase').forEach(btn => {
            btn.addEventListener('click', function() {
                const comboId = parseInt(this.getAttribute('data-combo-id'), 10);
                const quantityInput = document.querySelector(`.combo-qty-input[data-combo-id="${comboId}"]`);
                if (quantityInput) {
                    const currentVal = parseInt(quantityInput.value, 10) || 1;
                    const maxVal = parseInt(quantityInput.max, 10) || 10;
                    if (currentVal < maxVal) {
                        quantityInput.value = currentVal + 1;
                        updateComboQuantity(comboId, quantityInput.value);
                    }
                }
            });
        });
        
        document.querySelectorAll('.combo-qty-decrease').forEach(btn => {
            btn.addEventListener('click', function() {
                const comboId = parseInt(this.getAttribute('data-combo-id'), 10);
                const quantityInput = document.querySelector(`.combo-qty-input[data-combo-id="${comboId}"]`);
                if (quantityInput) {
                    const currentVal = parseInt(quantityInput.value, 10) || 1;
                    const minVal = parseInt(quantityInput.min, 10) || 1;
                    if (currentVal > minVal) {
                        quantityInput.value = currentVal - 1;
                        updateComboQuantity(comboId, quantityInput.value);
                    }
                }
            });
        });
        
        // Xử lý input số lượng
        document.querySelectorAll('.combo-qty-input').forEach(input => {
            input.addEventListener('change', function() {
                const comboId = parseInt(this.getAttribute('data-combo-id'), 10);
                const val = parseInt(this.value, 10) || 1;
                const minVal = parseInt(this.min, 10) || 1;
                const maxVal = parseInt(this.max, 10) || 10;
                if (val < minVal) {
                    this.value = minVal;
                } else if (val > maxVal) {
                    this.value = maxVal;
                }
                updateComboQuantity(comboId, this.value);
            });
            
            input.addEventListener('input', function() {
                if (this.value === '' || parseInt(this.value, 10) < 1) {
                    this.value = 1;
                }
            });
        });

        function updateBookingInfo(roomName, time, ngayChieu) {
            const cinemaSelect = document.getElementById('cinema-select');
            const cinemaName = cinemaSelect ? cinemaSelect.options[cinemaSelect.selectedIndex].text : 'Chưa chọn';

            const cinemaEl = document.getElementById('sum-cinema');
            if (cinemaEl) cinemaEl.innerHTML = `<strong>Rạp:</strong> ${cinemaName}`;
            const roomEl = document.getElementById('sum-room');
            if (roomEl) roomEl.innerHTML = `<strong>Phòng:</strong> ${roomName}`;

            const timeEl = document.getElementById('sum-time');
            if (timeEl) timeEl.innerHTML = `<strong>Giờ:</strong> ${time}`;
            const dateEl = document.getElementById('sum-date');
            if (dateEl) dateEl.innerHTML = `<strong>Ngày:</strong> ${ngayChieu}`;
            summaryInfo = {
                ...summaryInfo,
                cinema: cinemaName,
                room: roomName,
                time: time,
                date: ngayChieu
            };
            updateCheckoutHiddenFields();
        }

        function resetSummaryInfo() {
            selectedSeats = [];
            updateCartUI();

            const cinemaSelect = document.getElementById('cinema-select');
            const cinemaName = cinemaSelect ? cinemaSelect.options[cinemaSelect.selectedIndex].text : 'Chưa chọn';

            document.getElementById('sum-cinema').innerHTML = `<strong>Rạp:</strong> ${cinemaName}`;
            document.getElementById('sum-room').innerHTML = '<strong>Phòng:</strong> Chưa chọn';
            document.getElementById('sum-time').innerHTML = '<strong>Giờ:</strong> --:--';
            document.getElementById('sum-date').innerHTML = '<strong>Ngày:</strong> --/--/----';
            summaryInfo = {
                ...summaryInfo,
                cinema: cinemaName,
                room: 'Chưa chọn',
                time: '',
                date: ''
            };
            updateCheckoutHiddenFields();
        }


        function clearSeatMap() {
            currentMaSuat = 0;
            const container = document.getElementById('seat-map-container');
            if (!container) return;

            container.innerHTML = `
                <div class="d-flex flex-column align-items-center justify-content-center py-5 text-muted">
                    <i class="fa-regular fa-clock fa-3x mb-3"></i>
                    <h5>Vui lòng chọn suất chiếu để hiển thị ghế</h5>
                </div>
            `;
        }

        function filterShowtimeByDate(btnElement, selectedDate) {
            document.querySelectorAll('.date-btn').forEach(btn => btn.classList.remove('active'));
            btnElement.classList.add('active');

            currentSelectedDate = selectedDate;
            applyShowtimeFilters();
            resetSummaryInfo();
            clearSeatMap();
        }

        function handleCheckout() {
            const seatCount = getSelectedSeatCount();
            if (seatCount === 0) {
                alert('Bạn chưa chọn ghế.');
                return;
            }
            if (!summaryInfo.time || !summaryInfo.room || summaryInfo.room === 'Chưa chọn') {
                alert('Vui lòng chọn suất chiếu trước khi thanh toán.');
                return;
            }
            updateCheckoutHiddenFields();
            const checkoutForm = document.getElementById('checkout-form');
            if (checkoutForm) {
                checkoutForm.submit();
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            clearSeatMap();
            updateCartUI();
            updateCinemaInfo(false);
            summaryInfo.movie = document.getElementById('payment-movie-name')?.value || '';
            updateCheckoutHiddenFields();

            const firstDate = document.querySelector('.date-btn');
            if (firstDate) {
                firstDate.click();
            } else {
                applyShowtimeFilters();
            }

            const btnCheckout = document.getElementById('btn-checkout');
            if (btnCheckout) {
                btnCheckout.addEventListener('click', handleCheckout);
            }
        });
    </script>
</body>
</html>