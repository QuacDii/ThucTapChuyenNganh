@model TTCN.Models.PhongChieu

@{
    ViewData["Title"] = "Cập nhật Phòng Chiếu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="card shadow mb-4" style="max-width: 800px; margin: 0 auto;">

        <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom-primary">
            <h5 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-edit mr-2"></i> Cập nhật Phòng Chiếu
            </h5>
        </div>

        <div class="card-body">
            <form asp-action="sua" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="MaPhong" />

                <div class="row">
                    <div class="col-md-6">

                        <div class="form-group mb-3">
                            <label asp-for="TenPhong" class="control-label font-weight-bold"></label>
                            <input asp-for="TenPhong" class="form-control" placeholder="Ví dụ: Phòng 01..." />
                            <span asp-validation-for="TenPhong" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="TongGhe" class="control-label font-weight-bold"></label>
                            <div class="input-group">
                                <input asp-for="TongGhe" class="form-control" type="number" min="1" />
                                <span class="input-group-text">ghế</span>
                            </div>
                            <span asp-validation-for="TongGhe" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="MaCumRap" class="control-label font-weight-bold">Thuộc Cụm Rạp</label>

                            <select asp-for="MaCumRap" class="form-control form-select" asp-items="ViewBag.dsCumRap">
                                <option value="">-- Chọn Cụm Rạp --</option>
                            </select>

                            <span asp-validation-for="MaCumRap" class="text-danger"></span>
                            <small class="text-muted mt-2 d-block">
                                <i class="fas fa-info-circle"></i> Thay đổi cụm rạp sẽ ảnh hưởng đến thống kê doanh thu.
                            </small>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="text-center">
                    <a asp-action="Index" class="btn btn-secondary px-4 mr-2">
                        <i class="fas fa-arrow-left mr-1"></i> Quay lại
                    </a>

                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save mr-1"></i> Lưu thay đổi
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}