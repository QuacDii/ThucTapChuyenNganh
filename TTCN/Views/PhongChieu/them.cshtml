@model TTCN.Models.PhongChieu

@{
    ViewData["Title"] = "Thêm Phòng Chiếu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <div class="card shadow mb-4" style="max-width: 800px; margin: 0 auto;">

        <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom-primary">
            <h5 class="m-0 font-weight-bold text-primary">
                Thêm Phòng Chiếu Mới
            </h5>
        </div>

        <div class="card-body">
            <form asp-action="them" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6">

                        <div class="form-group mb-3">
                            <label asp-for="TenPhong" class="control-label font-weight-bold"></label>
                            <input asp-for="TenPhong" class="form-control" placeholder="Ví dụ: Phòng 01, IMAX..." />
                            <span asp-validation-for="TenPhong" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="TongGhe" class="control-label font-weight-bold"></label>
                            <div class="input-group">
                                <input asp-for="TongGhe" class="form-control" type="number" min="1" placeholder="Nhập số lượng ghế..." />
                                <span class="input-group-text">ghế</span>
                            </div>
                            <span asp-validation-for="TongGhe" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group mb-3">
                            <label asp-for="MaCumRap" class="control-label font-weight-bold">Thuộc Cụm Rạp</label>

                            <select asp-for="MaCumRap" class="form-control form-select" asp-items="ViewBag.dsCumRap">
                                <option value="">-- Chọn Cụm Rạp --</option>
                            </select>

                            <span asp-validation-for="MaCumRap" class="text-danger"></span>
                            <small class="form-text text-muted fst-italic mt-2">
                                <i class="fas fa-info-circle"></i> Vui lòng chọn đúng cụm rạp chứa phòng chiếu này.
                            </small>
                        </div>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="text-center">
                    <a asp-action="Index" class="btn btn-secondary px-4 mr-2">
                        <i class="fas fa-arrow-left mr-1"></i> Quay lại
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save mr-1"></i> Lưu lại
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}