@model IEnumerable<TTCN.Models.PhongChieu>

@{
    ViewData["Title"] = "Quản lý Phòng Chiếu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var dsCumRap = ViewBag.dsCumRap as SelectList;
}

<style>
    .table thead th {
        background-color: #4e73df;
        color: white;
        border: none;
        white-space: nowrap;
        vertical-align: middle;
    }

    .table tbody td {
        vertical-align: middle;
        color: #5a5c69;
    }

    .table-hover tbody tr:hover {
        background-color: #f8f9fc;
    }

    /* Style cho badge số ghế */
    .seat-badge {
        font-size: 0.9rem;
        background-color: #eaecf4;
        color: #4e73df;
        padding: 5px 10px;
        border-radius: 15px;
        font-weight: bold;
    }
</style>

<div class="container-fluid">
    <div class="card shadow mb-4 border-0">

        <div class="card-header py-3 d-flex justify-content-between align-items-center bg-white border-bottom-primary">
            <h5 class="m-0 font-weight-bold text-primary">
                <i class="fas fa-door-open mr-2"></i> Danh sách Phòng Chiếu
            </h5>
            <a asp-action="them" class="btn btn-primary btn-icon-split shadow-sm">
                <span class="icon text-white-50">
                    <i class="fas fa-plus"></i>
                </span>
                <span class="text">Thêm Phòng Mới</span>
            </a>
        </div>

        <div class="card-body">

            <form asp-action="Index" method="get" class="mb-4">
                <div class="row g-2 align-items-center">

                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-right-0"><i class="fas fa-search text-gray-400"></i></span>
                            <input type="text" name="search" value="@ViewBag.CurrentSearch"
                                   class="form-control border-left-0 small" placeholder="Tìm tên phòng...">
                        </div>
                    </div>

                    <div class="col-md-3">
                        <select name="maCum" class="form-control form-select bg-light small"
                                asp-items="@dsCumRap">
                            <option value="">-- Tất cả Cụm Rạp --</option>
                        </select>
                    </div>
                    <div class="col-md-4 d-flex align-items-center">
                        <button type="submit" class="btn btn-primary shadow-sm px-3">
                            <i class="fas fa-filter fa-sm text-white-50 me-1"></i> Lọc
                        </button>

                        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm ms-1" title="Tải lại">
                            <i class="fas fa-sync-alt"></i>
                        </a>
                        <div class="border-start mx-3" style="height: 24px; border-color: #e3e6f0 !important;"></div>
                        <div class="d-flex align-items-center text-nowrap">
                            <span class="text-muted small">Tổng:</span>
                            <span class="badge bg-light text-dark border ms-2 me-2 px-2 py-1">
                                @(Model != null ? Model.Count() : 0)
                            </span>
                            <span class="text-muted small">phòng</span>
                        </div>
                    </div>
                </div>
            </form>

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-hover mb-0" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr class="text-center">
                            <th style="width: 100px;">
                                @Html.DisplayNameFor(model => model.FirstOrDefault().MaPhong)
                            </th>

                            <th class="text-center">
                                @Html.DisplayNameFor(model => model.FirstOrDefault().TenPhong)
                            </th>

                            <th>
                                Thuộc Cụm Rạp
                            </th>

                            <th style="width: 150px;">
                                @Html.DisplayNameFor(model => model.FirstOrDefault().TongGhe)
                            </th>

                            <th style="width: 120px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center font-weight-bold">
                                        @item.MaPhong
                                    </td>

                                    <td class="text-center font-weight-bold ">
                                        @item.TenPhong
                                    </td>

                                    <td class="text-center">
                                        @if (item.MaCumRapNavigation != null)
                                        {
                                            <span class="badge bg-info text-white p-2 shadow-sm">
                                                <i class="fas fa-building mr-1"></i> @item.MaCumRapNavigation.TenCumRap
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">---</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        <span class="seat-badge">
                                            @item.TongGhe <small>ghế</small>
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a asp-action="sua" asp-route-id="@item.MaPhong" class="btn btn-outline-warning btn-sm shadow-sm" title="Sửa">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <a asp-action="xoa" asp-route-id="@item.MaPhong" class="btn btn-outline-danger btn-sm shadow-sm" title="Xóa">
                                                <i class="fas fa-trash-alt"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <img src="https://cdn-icons-png.flaticon.com/512/7486/7486754.png" width="60" alt="Empty" class="mb-3 opacity-50" />
                                    <p class="text-muted mb-0">Chưa có dữ liệu phòng chiếu nào.</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>